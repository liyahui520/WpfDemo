<UserControl x:Class="WpfMain.Module.FrmHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfMain.Module"
             xmlns:langs="https://handyorg.github.io/handycontrol" 
             mc:Ignorable="d" DataContext="{Binding RelativeSource={RelativeSource Self}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="32,10,32,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"  CornerRadius="10" Margin="0,0,0,5">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.4"/>
            </Border.Background>
<Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="10,0,10,0" VerticalContentAlignment="Center"  langs:InfoElement.ShowClearButton="True"  VerticalAlignment="Center" langs:InfoElement.TitleWidth="80" langs:InfoElement.Placeholder="请入查询条件"  langs:InfoElement.TitlePlacement="Left" langs:InfoElement.Title="请入查询条件" />
                <Button Content="查询" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
        <DataGrid Grid.Row="1" IsReadOnly="True" VirtualizingPanel.ScrollUnit="Pixel" BorderThickness="0"  VirtualizingStackPanel.IsVirtualizing ="True"  HeadersVisibility="All" RowHeaderWidth="60" langs:DataGridAttach.ShowRowNumber="False"  ScrollViewer.HorizontalScrollBarVisibility="Auto"  ItemsSource="{Binding DataList}"  AutoGenerateColumns="False">
            <DataGrid.Background>
                <SolidColorBrush Color="White" Opacity="0.4"/> 
            </DataGrid.Background>  
            <!--<DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>-->
                <DataGrid.Columns>
                <!--<DataGridTextColumn IsReadOnly="True" Width="80" CanUserResize="False" Binding="{Binding }" Header="序号"/>-->
                <DataGridTextColumn Binding="{Binding Customer}" Header="客户"/>
                <DataGridTextColumn Binding="{Binding CustomerPhone}" Header="手机号"/>
                <DataGridTextColumn Binding="{Binding Pet}" Header="宠物名"/>
                <DataGridTextColumn Binding="{Binding Gender}" Header="性别"/>
                <!--<DataGridTextColumn Binding="{Binding DeviceName}" Header="设备"/>-->
                <DataGridTextColumn Binding="{Binding TestName}" Header="名称"/>
                <DataGridTextColumn Binding="{Binding See}" Header="所见"/>
                <DataGridTextColumn Binding="{Binding Size}" Header="大小"/>
                <DataGridTextColumn Binding="{Binding Count}" Header="数量"/>
                <DataGridTextColumn Binding="{Binding DCOperation}" Header="检查医生"/>
                <DataGridTextColumn Binding="{Binding TestDate}" Header="检查时间"/>

                <DataGridTextColumn Binding="{Binding Result.Remark}" Width="*" Header="备注"/>
                <DataGridTextColumn Width="100" Header="缩略图"/>

                <DataGridTemplateColumn Header="操作" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/1_0.png" Width="24" Height="24"></Image>
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/2_0.png" Width="24" Height="24"></Image>
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/3_0.png" Width="24" Height="24"></Image>
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/play-circle.png" Width="24" Height="24"></Image>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>
            </DataGrid>

        <!--<langs:Pagination Grid.Row="1" MaxPageCount="10" PageIndex="{Binding PageIndex}" IsJumpEnabled="True">
            <langs:Interaction.Triggers>
                <langs:EventTrigger EventName="PageUpdated">
                    <langs:EventToCommand Command="{Binding PageUpdatedCmd}" PassEventArgsToCommand="True" />
                </langs:EventTrigger>
            </langs:Interaction.Triggers>
        </langs:Pagination>-->
    </Grid>
</UserControl>
