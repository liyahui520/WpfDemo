<UserControl x:Class="WpfMain.Module.FrmHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:local="clr-namespace:WpfMain.Module" 
             mc:Ignorable="d" DataContext="{Binding RelativeSource={RelativeSource Self}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="32,10,32,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"  CornerRadius="10" Margin="0,0,0,5">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.4"/>
            </Border.Background>
            <Grid>
                <VirtualizingStackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,10,0,5">
                    <TextBox Margin="10,0,10,0" VerticalContentAlignment="Center"  hc:InfoElement.ShowClearButton="True" x:Name="param" VerticalAlignment="Center" Width="220" hc:InfoElement.TitleWidth="80" hc:InfoElement.Placeholder="请入查询条件"  hc:InfoElement.TitlePlacement="Left" hc:InfoElement.Title="请入查询条件" />
                    <hc:DateTimePicker hc:InfoElement.ShowClearButton="True" Width="160" x:Name="startTime"/>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,5,0" Text="至"  FontSize="14"  Style="{StaticResource TextBlockDefault}"/>
                    <hc:DateTimePicker hc:InfoElement.ShowClearButton="True" Width="160" x:Name="endTime"/>
                    <Button Content="查询" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Click="ButtonBase_OnClick"/>
                </VirtualizingStackPanel>
            </Grid>
        </Border>
        <DataGrid Grid.Row="1" IsReadOnly="True" VirtualizingPanel.ScrollUnit="Pixel" BorderThickness="0"  VirtualizingStackPanel.IsVirtualizing ="True"  HeadersVisibility="All" RowHeaderWidth="60" hc:DataGridAttach.ShowRowNumber="False"  ScrollViewer.HorizontalScrollBarVisibility="Auto"  ItemsSource="{Binding DataList}"  AutoGenerateColumns="False">
            <DataGrid.Background>
                <SolidColorBrush Color="White" Opacity="0.4"/>
            </DataGrid.Background>
            <!--<DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>-->
            <DataGrid.Columns>
                <!--<DataGridTextColumn IsReadOnly="True" Width="80" CanUserResize="False" Binding="{Binding }" Header="序号"/>-->
                <DataGridTextColumn Binding="{Binding Customer}" Header="客户"/>
                <DataGridTextColumn Binding="{Binding CustomerPhone}" Header="手机号"/>
                <DataGridTextColumn Binding="{Binding Pet}" Header="宠物名"/>
                <DataGridTextColumn Binding="{Binding Gender}" Header="性别"/>
                <!--<DataGridTextColumn Binding="{Binding DeviceName}" Header="设备"/>-->
                <DataGridTextColumn Binding="{Binding TestName}" Header="名称"/>
                <!--<DataGridTextColumn Binding="{Binding See}" Header="所见"/>
                <DataGridTextColumn Binding="{Binding Size}" Header="大小"/>
                <DataGridTextColumn Binding="{Binding Count}" Header="数量"/>-->
                <DataGridTextColumn Binding="{Binding DCOperation}" Header="检查医生"/>
                <DataGridTextColumn Binding="{Binding TestDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Header="检查时间"/>
                <DataGridTextColumn Binding="{Binding Result.Remark}" Width="*" Header="备注"/>
                <!--<DataGridTextColumn Width="100" Header="缩略图"/>-->

                <DataGridTemplateColumn Header="操作" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="2" Style="{StaticResource ButtonIcon}" Foreground="#1296db" Padding="0" Height="24" Width="24" ToolTip="查看报告" hc:IconElement.Geometry="{StaticResource BaoGaoGeometry}"/>
                                <Button Margin="2" Style="{StaticResource ButtonIcon}" Foreground="#1296db" Padding="0" Height="24" Width="24" ToolTip="查看影像" hc:IconElement.Geometry="{StaticResource SanImgGeometry}"/>
                                <Button Margin="2" Style="{StaticResource ButtonIcon}" Foreground="#1296db" Padding="0" Height="24" Width="24" ToolTip="查看视频"  hc:IconElement.Geometry="{StaticResource SanVideoGeometry}"/>
                                <Button Margin="2" Style="{StaticResource ButtonIcon}" Foreground="PaleVioletRed" Padding="0" Height="24" Width="24" ToolTip="删除" hc:IconElement.Geometry="{StaticResource DeleteGeometry}"/>
                                <!--<Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/1_0.png" Width="24" Height="24"></Image>
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/2_0.png" Width="24" Height="24"></Image>
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/3_0.png" Width="24" Height="24"></Image>
                                <Image Margin="2" Source="pack://siteoforigin:,,,/Static/Images/play-circle.png" Width="24" Height="24"></Image>-->
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!--<langs:Pagination Grid.Row="1" MaxPageCount="10" PageIndex="{Binding PageIndex}" IsJumpEnabled="True">
            <langs:Interaction.Triggers>
                <langs:EventTrigger EventName="PageUpdated">
                    <langs:EventToCommand Command="{Binding PageUpdatedCmd}" PassEventArgsToCommand="True" />
                </langs:EventTrigger>
            </langs:Interaction.Triggers>
        </langs:Pagination>-->
    </Grid>
</UserControl>
