<Window
    x:Class="WpfMain.Module.FrmModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:petModule="clr-namespace:WpfMain.Module.PetModule"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="MainWindow"  
    MinWidth="1200"
    MinHeight="750"  BorderBrush="Transparent"
    WindowStartupLocation="CenterScreen"  Margin="0" Padding="0" BorderThickness="0"
    mc:Ignorable="d" WindowStyle="None" WindowState="Maximized">
 
    <Grid Margin="0" hc:BorderElement.Circular="True">
        <Grid.Background>
            <ImageBrush ImageSource="pack://SiteOfOrigin:,,,/Static/Images/background.jpg"   Opacity="0.9"
                        Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"  HorizontalAlignment="Left" VerticalAlignment="Center">
                <hc:SimpleText x:Name="title" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,0,0,0"></hc:SimpleText>
            </StackPanel>
            <StackPanel Grid.Column="1"  HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="5" Click="ButtonSetting_OnClick"  hc:IconElement.Geometry="{StaticResource SettingGeometry}" Width="40" Style="{StaticResource ButtonOpacityCustom}" hc:BorderElement.CornerRadius="5" Foreground="White" Effect="{StaticResource EffectShadow5}" BorderThickness="0"/>
                <hc:Divider LineStrokeThickness="2" LineStroke="{DynamicResource DarkPrimaryBrush}" Orientation="Vertical" MaxHeight="20"/>
            </StackPanel>
            <StackPanel  Grid.Column="2"   HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Margin="5" Click="ButtonBase_OnClick"  hc:IconElement.Geometry="{StaticResource CloseGeometry}" Width="30" Style="{StaticResource ButtonOpacityCustom}" hc:BorderElement.CornerRadius="5" Foreground="White" Effect="{StaticResource EffectShadow5}" BorderThickness="0"/>
            </StackPanel>
        </Grid>
        <Border  Grid.Row="1" >
            <UserControl x:Name="Control"></UserControl>
        </Border>
        <!--<petModule:FrmPet Grid.Row="1" />-->
    </Grid>
</Window>
