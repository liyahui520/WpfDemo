<UserControl xmlns:Controlls="clr-namespace:WpfMain.Controlls"  x:Class="WpfMain.Module.PetModule.FrmPet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfMain.Module.PetModule"
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             mc:Ignorable="d" 
             xmlns:wm="clr-namespace:WpfMain.Module" 
             xmlns:controls1="clr-namespace:WPFMediaKit.DirectShow.Controls;assembly=WPFMediaKit"
             d:DesignHeight="450" d:DesignWidth="1800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             Loaded="UserControl_Loaded"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Module/PetModule/Geometries.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition />
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <!--<Border Grid.Column="0" CornerRadius="10">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.2"/>
                </Border.Background>
                <Button x:Name="ButtonShiftOut" Foreground="White" BorderThickness="0" BorderBrush="Transparent"  hc:IconElement.Geometry="{StaticResource LeftGeometry}" Padding="8 8 0 8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 26 -16 0" Style="{StaticResource ButtonIconCircular}" >
                    <Button.Background>
                        <SolidColorBrush Color="White" Opacity="0.2"/>
                    </Button.Background>
                </Button>
            </Border>-->


            <Border Grid.Column="0" CornerRadius="10" DataContext="{Binding }">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.2"/>
                </Border.Background>
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,5,0,0" Padding="10" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" FontSize="14">检查拍摄</TextBlock>
                    <ScrollViewer Grid.Row="1" hc:ScrollViewerAttach.Orientation="Vertical" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                        <StackPanel Orientation="Vertical">
                            <Expander Header="录像" Margin="0,4,0,0" IsExpanded="True" BorderThickness="0" Foreground="White" FontSize="20">
                                <Expander.Background>
                                    <SolidColorBrush Color="White" Opacity="0.2"/>
                                </Expander.Background>
                                <Border Height="150" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="0,0,4,4"  Padding="10">
                                    <Border.Background>
                                        <SolidColorBrush Color="White" Opacity="0.2"/>
                                    </Border.Background>
                                    <StackPanel Margin="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <CheckBox Grid.Column="0" Foreground="White" Content="开启音频" Checked="ToggleButton_OnChecked" Unchecked="ToggleButton_OnUnchecked" IsChecked="{Binding VideoModel.ExposureModel.IsAuto}" IsEnabled="{Binding VideoModel.ExposureModel.IsEnable}" Margin="5,5,0,0"/>
                                            <VirtualizingStackPanel Grid.Row="1"  VerticalAlignment="Center" Orientation="Horizontal"  Margin="5,10,0,0">
                                                <!--<TextBlock HorizontalAlignment="Left" Text="视频保存地址：" Style="{StaticResource TextBlockDefaultSecLight}"/>-->
                                                <!--<TextBlock HorizontalAlignment="Left" Text="D://video" Style="{StaticResource TextBlockDefaultSecLight}"/>-->
                                                <!--<TextBlock HorizontalAlignment="Left" Text="修改" Margin="10,0,0,0" Style="{StaticResource TextBlockDefaultSuccess}"/>-->
                                            </VirtualizingStackPanel>
                                        </Grid>
                                        <!--<Slider Margin="0,10,0,0"  hc:TipElement.Visibility="Visible" hc:TipElement.Placement="Top"  IsSnapToTickEnabled="True" Maximum="100" Minimum="0" Value="20" TickFrequency="10"  TickPlacement="Both"/>-->
                                        <VirtualizingStackPanel VerticalAlignment="Center" Orientation="Horizontal" Height="40" Margin="5,5,0,0">
                                            <Button Content="开始录像" Margin="5" x:Name="StartCamp" Click="StartCamp_OnClick" Style="{StaticResource ButtonInfo}" Foreground="White"/>
                                            <Button Content="拍照" Margin="5" x:Name="EndCamp" Click="EndCamp_OnClick" Style="{StaticResource ButtonSuccess}" Foreground="White"/>
                                        </VirtualizingStackPanel>
                                        <StackPanel Orientation="Horizontal" Height="30" Margin="5,5,0,0" x:Name="timeT" Visibility="Hidden">
                                            <TextBlock Text="正在录像中：" Margin="5" FontSize="14"/>
                                            <TextBlock Text="00:00:00" Margin="5" x:Name="LXDate1" FontSize="14"/>
                                        </StackPanel>
                                        <!--<Button Content="保存" Margin="5" Click="Button_SaveTest"/>-->

                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="遮罩" Margin="0,4,0,0" IsExpanded="True" BorderThickness="0" Foreground="White" FontSize="20">
                                <Expander.Background>
                                    <SolidColorBrush Color="White" Opacity="0.2"/>
                                </Expander.Background>
                                <Border Height="50" BorderThickness="0,1,0,0"  BorderBrush="{DynamicResource BorderBrush}" CornerRadius="0,0,4,4">
                                    <Border.Background>
                                        <SolidColorBrush Color="Black" Opacity="0.2"/>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Resources>
                                            <Style  BasedOn="{StaticResource ButtonDashedBaseStyle}"  TargetType="{x:Type Button}">
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="White" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <!--<Button Margin="5" Style="{StaticResource ButtonDashedInfo}" x:Name="mask" Click="Mask_OnClick" ToolTip="遮罩" FontSize="30" Width="30" Height="30" Padding="2" hc:IconElement.Geometry="{StaticResource MaskGeometry}"/>
                                        <Button Margin="5" Style="{StaticResource ButtonDashedInfo}" x:Name="screenshot" ToolTip="截图"  Command="hc:ControlCommands.StartScreenshot" FontSize="30" Width="30" Height="30" Padding="2" hc:IconElement.Geometry="{StaticResource ScreenshotGeometry}"/>-->
                                        <Button Margin="5" x:Name="mask" Command="wm:StartMaskhotCommand.StartMaskhot" ToolTip="遮罩(鼠标右键或ESC键取消)" FontSize="30" Width="30" Height="30" Padding="2" hc:IconElement.Geometry="{StaticResource MaskGeometry}"/>
                                        <Button Margin="5" x:Name="screenshot" ToolTip="截图(鼠标右键或ESC键取消)"  Command="hc:ControlCommands.StartScreenshot" FontSize="30" Width="30" Height="30" Padding="2" hc:IconElement.Geometry="{StaticResource ScreenshotGeometry}"/>

                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!--<Expander Header="分辩率" Margin="0,4,0,0" >
                                <Border Height="60" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4"  Padding="10">
                                </Border>
                            </Expander>
                            <Expander Header="Binning" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="曝光控制" Margin="0,4,0,0" >
                                <Border  BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" >
                                    <StackPanel Margin="10,20,10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="自动" IsChecked="{Binding ExposureModel.IsAuto}" x:Name="cameraUCSetting" Checked="CameraUCSetting_OnChecked" Unchecked="CameraUCSetting_OnUnchecked"/>
                                            <TextBox Grid.Column="1" Text="{Binding ExposureModel.IsEdit,UpdateSourceTrigger=PropertyChanged}" Width="120" IsEnabled="{Binding ExposureModel.IsEdit,UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <Slider Margin="0,10,0,10"  IsEnabled="{Binding ExposureModel.IsEdit,UpdateSourceTrigger=PropertyChanged}" hc:TipElement.Visibility="Visible" hc:TipElement.Placement="Top" x:Name="cameraUC" ValueChanged="CameraUC_OnValueChanged" IsSnapToTickEnabled="True" Maximum="100" Minimum="-100" Value="{Binding ExposureModel.Value,UpdateSourceTrigger=PropertyChanged}" TickFrequency="10"  TickPlacement="Both"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <Expander Header="深度" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="白平衡" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="图像调整" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="直方图" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="温度控制" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>

                            <Expander Header="文件保存" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="感兴趣区域（ROI）" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="遮罩" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="图像拼接（动态）" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>
                            <Expander Header="景深扩展（动态）" Margin="0,4,0,0" >
                                <Border Height="100" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RegionBrush}" CornerRadius="0,0,4,4" />
                            </Expander>-->
                        </StackPanel>
                    </ScrollViewer>

                    <Controlls:UCFiles Grid.Row="2" ParentData="{Binding tInfo, Mode=TwoWay}" x:Name="Files" ImagesClick="UCFiles_OnImagesClick" VideoClick="UCFiles_OnVideoClick"></Controlls:UCFiles>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="5,0,5,0" DataContext="{Binding }">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Border  CornerRadius="10" Name="BorderVideo" >
                    <Border.Background>
                        <SolidColorBrush Color="#665666" Opacity="0.6"/>
                    </Border.Background>
                    
                    
                    
                    
                    
                </Border>
                <!--<Controlls:UCMFVideo x:Name="UcmfVideo"/>-->

            </Grid>
            <Grid Grid.Column="2">
                <Border  CornerRadius="10">
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.2"/>
                    </Border.Background>
                    
                    <StackPanel>

                        <Controlls:PropertyGridDemoCtl x:Name="Ctl" Margin="10" Background="Transparent" ParentData="{Binding tInfo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                        <VirtualizingStackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,10,0,5">
                            <Button Content="保存" Margin="20,0,20,0" Width="120" Click="Button_SaveTest"  Style="{StaticResource ButtonSuccess}"/>
                            <Button Content="打印" Margin="20,0,0,0" Width="120" Click="Button_Save_Print_Test"  Style="{StaticResource ButtonPrimary}"/> 
                        </VirtualizingStackPanel>
                    </StackPanel>

                    <!--<hc:PropertyItemsControl Background="Transparent" BorderThickness="0"></hc:PropertyItemsControl>-->
                    <!--<hc:PropertyGrid hc:BorderElement.CornerRadius="10"  SelectedObject="{Binding DemoModel}"/>-->
                </Border>
            </Grid>
        </Grid>
    </Border>

</UserControl>
