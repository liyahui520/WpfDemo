<hc:Window x:Class="WpfMain.Module.FrmBackModule"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:local="clr-namespace:WpfMain.Module"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d" MinWidth="1200"
           MinHeight="750"
           ShowNonClientArea="False"
           ShowTitle="True" 
           WindowStartupLocation="CenterScreen"   WindowStyle="None" WindowState="Maximized"
           d:DesignHeight="450" d:DesignWidth="800">
    <hc:Window.Background>
        <ImageBrush ImageSource="pack://SiteOfOrigin:,,,/Static/Images/background.jpg"  Opacity="0.9"/>
    </hc:Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions> 
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1"  HorizontalAlignment="Left" VerticalAlignment="Center">
                <hc:SimpleText x:Name="title" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,0,0,0"></hc:SimpleText>
            </StackPanel>
            <StackPanel Grid.Column="0"  HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="5" Style="{StaticResource ButtonOpacityCustom}" Click="ButtonBase_OnClick" hc:IconElement.Geometry="{StaticResource LeftGeometry}" hc:BorderElement.CornerRadius="5" Foreground="White" Effect="{StaticResource EffectShadow5}" BorderThickness="0" Content="返回上一步"/> 
            </StackPanel> 
        </Grid>
        <Border  Grid.Row="1" >
            <UserControl x:Name="Control"></UserControl>
        </Border>
        <!--<petModule:FrmPet Grid.Row="1" />-->
    </Grid>
</hc:Window>
