<UserControl x:Class="WpfMain.Controlls.UCPrintNotes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfMain.Controlls"
             xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit" Loaded="UCPrintNotes_OnLoaded"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <dxre:RichEditControl x:Name="richEditControl1" CommandBarStyle="Empty"  BarManager="{Binding ElementName=barManager1, Mode=OneTime}"/>
    </Grid>
</UserControl>
