<hc:Window  x:Class="WpfMain.Controlls.UCLocalVideo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:local="clr-namespace:WpfMain.Controlls"
           xmlns:controls="clr-namespace:AForge.Controls;assembly=AForge.Controls"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d" 
           d:DesignHeight="450" d:DesignWidth="800">
    <Window.Resources>
        <!-- 颜色资源 -->
        <Color x:Key="PrimaryColor">#FF2196F3</Color>
        <Color x:Key="DarkBackground">#1E1E1E</Color>
        <Color x:Key="LightBackground">#FAFAFA</Color>
        <!-- 画刷资源 -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF64B5F6" Offset="0"/>
            <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DarkBackground}"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#7FFFFFFF"/>

        <!-- 控件样式 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="CornflowerBlue"/>
            <Setter Property="Background" Value="#3FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <!--<Setter Property="Thumb.DragStarted" Value="Slider_DragStarted"/>
            <Setter Property="Thumb.DragCompleted" Value="Slider_DragCompleted"/>-->
        </Style>

        <!-- 矢量图标 -->
        <PathGeometry x:Key="PlayIcon" Figures="M 8,4.5 L 18,12 8,19.5 z"/>
        <PathGeometry x:Key="PauseIcon" Figures="M 6,4 H10 V20 H6z M14,4 H18 V20 H14z"/>
        <PathGeometry x:Key="StopIcon" Figures="M 5,5 H19 V19 H5 z"/>
        <PathGeometry x:Key="OpenFileIcon" Figures="M14,2H6C4.9,2 4,2.9 4,4V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2z M18,20H6V4H13V9H18V20z"/>
    </Window.Resources>

    <Grid>
        <WindowsFormsHost Grid.Row="0" Margin="0,0,0,50">
        <!-- 视频显示区域 -->
        <controls:VideoSourcePlayer x:Name="videoPlayer"   />
        </WindowsFormsHost>

        <!-- 控制面板 -->
        <Border VerticalAlignment="Bottom"
                Background="#CC000000"
                Height="60"
                CornerRadius="0,0 0 0">
            <Grid Margin="0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 进度条 -->
                <Slider x:Name="progressSlider"
                        Grid.Row="0"
                        Margin="0,8" 
                        ToolTip="当前进度"
                        IsMoveToPointEnabled="True"/>

                <!-- 控制按钮 -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- 打开文件按钮 -->
                    <Button x:Name="btnOpen" 
                            ToolTip="打开文件" >
                        <Path Data="{StaticResource OpenFileIcon}"
                              Fill="{StaticResource SecondaryBrush}"
                              Stretch="Uniform"
                              Width="24"
                              Height="24"/>
                    </Button>

                    <!-- 播放/暂停按钮 -->
                    <Button x:Name="btnPlayPause" 
                            Margin="20,0"
                            Click="BtnPlayPause_Click">
                        <Path x:Name="playPauseIcon"
                              Data="{StaticResource PlayIcon}"
                              Fill="{StaticResource SecondaryBrush}"
                              Stretch="Uniform"
                              Width="24"
                              Height="24"/>
                    </Button>

                    <!-- 停止按钮 -->
                    <Button x:Name="btnStop" 
                            Click="BtnStop_Click">
                        <Path Data="{StaticResource StopIcon}"
                              Fill="{StaticResource SecondaryBrush}"
                              Stretch="Uniform"
                              Width="24"
                              Height="24"/>
                    </Button>

                    <!-- 音量控制 -->
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                              Fill="{StaticResource SecondaryBrush}"
                              Margin="0,0,8,0"
                              Width="24"
                              Height="24"/>
                        <Slider x:Name="volumeSlider" 
                                Width="100"
                                Minimum="0" Maximum="1" 
                                Value="0.5"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- 时间显示 -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryBrush}"
                           FontSize="14"
                           Margin="0,0,20,0">
                    <Run x:Name="currentTimeText" Text="00:00"/>
                    <Run Text="/"/>
                    <Run x:Name="totalTimeText" Text="00:00"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 加载动画 -->
        <Border x:Name="loadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
            <ProgressBar 
                         IsIndeterminate="True"
                         Width="50"
                         Height="50"
                         Foreground="#393fff"/>
        </Border>
    </Grid>
</hc:Window>