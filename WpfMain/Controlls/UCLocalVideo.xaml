<hc:Window  x:Class="WpfMain.Controlls.UCLocalVideo"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
          xmlns:hc="https://handyorg.github.io/handycontrol"
            xmlns:vlc="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf"
            mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800">
    <Window.Background>
        <ImageBrush ImageSource="pack://SiteOfOrigin:,,,/Static/Images/background.jpg" Stretch="UniformToFill" />
    </Window.Background>
    <!-- 资源样式定义 -->
    <Window.Resources>
        <!-- 按钮样式 -->
        <Style TargetType="Button" x:Key="ControlButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条增减按钮样式 -->
        <Style x:Key="SliderDecreaseRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" Height="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderIncreaseRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" Height="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 进度条样式 - 修复了ThumbStyle问题 -->
        <Style TargetType="Slider" x:Key="ProgressBarStyle">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="#00A8FF"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{TemplateBinding Foreground}" 
                                                  Style="{StaticResource SliderDecreaseRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{TemplateBinding Background}" 
                                                  Style="{StaticResource SliderIncreaseRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Background="{TemplateBinding Foreground}" 
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="{TemplateBinding Background}" 
                                                         Stroke="#FFFFFF" 
                                                         StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- 音量滑块样式 -->
        <Style TargetType="Slider" x:Key="VolumeSliderStyle" BasedOn="{StaticResource ProgressBarStyle}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="100"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <!-- 视频播放区域（居中，带圆角） -->
        <Border CornerRadius="10" 
                Background="#1A1A1A" 
                Margin="0 0 0 0"
                MouseLeftButtonDown="VideoArea_MouseClick"
                ToolTip="点击播放/暂停">
            <!-- 加载提示 --> 

            <vlc:VlcControl x:Name="vlcControl" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            Visibility="Visible"/>
        </Border>

        <!-- 控制区域 -->
        <Grid Margin="10 0 " VerticalAlignment="Bottom" Height="35">
            <!-- 进度条及时间显示 -->
            <Grid VerticalAlignment="Top" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 当前时间 -->
                <TextBlock x:Name="txtCurrentTime" 
                           Text="00:00"  
                           Margin="0 12 10 0"
                           Foreground="White" 
                           FontSize="12"/>

                <!-- 进度条 -->
                <Slider x:Name="sldProgress" 
                        Grid.Column="1"  
                        Margin="0 6 0 0" 
                        
                        PreviewMouseDown="sldProgress_PreviewMouseDown"  
                    PreviewMouseMove="sldProgress_PreviewMouseMove" 
                    PreviewMouseUp="sldProgress_PreviewMouseUp" Maximum="100" />

                <!-- 总时长 -->
                <TextBlock x:Name="txtTotalTime" 
                           Text="00:00"  
                           Grid.Column="2"
                           Foreground="White" 
                           Margin="10 12 0 0"
                           FontSize="12"/>
            </Grid>

            <!-- 控制按钮区域 -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Bottom" Visibility="Collapsed" 
                         >
                <Button x:Name="btnOpen" 
                        Style="{StaticResource ControlButtonStyle}"
                        ToolTip="打开文件"
                        Click="BtnOpen_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text=""/>
                </Button>

                <Button x:Name="btnPlay" 
                        Style="{StaticResource ControlButtonStyle}"
                        ToolTip="播放/暂停"
                        Click="BtnPlay_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text=""/>
                </Button>

                <Button x:Name="btnStop" 
                        Style="{StaticResource ControlButtonStyle}"
                        ToolTip="停止"
                        Click="BtnStop_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text=""/>
                </Button>

                <Separator Width="1" Height="20" Background="#4A4A4A" Margin="5 0"/>

                <TextBlock Text="" 
                           FontFamily="Segoe MDL2 Assets" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Slider x:Name="sldVolume" 
                        Style="{StaticResource VolumeSliderStyle}"
                        ValueChanged="sldVolume_ValueChanged"
                        ToolTip="调节音量" Height="10" Width="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</hc:Window>