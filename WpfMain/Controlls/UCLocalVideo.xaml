<hc:Window  x:Class="WpfMain.Controlls.UCLocalVideo"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
          xmlns:local="clr-namespace:WpfMain.Controlls" 
          xmlns:hc="https://handyorg.github.io/handycontrol" 
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800">
    <Window.Resources>
        <!-- 自定义单曲循环图标（若需要） -->
        <Geometry x:Key="LoopSingleGeometry">F1 M30,15 A15,15 0 0 1 30,45 A15,15 0 0 1 30,15 z M25,30 L35,30</Geometry>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 标题栏 -->
            <RowDefinition Height="*"/>
            <!-- 视频区 -->
            <RowDefinition Height="Auto"/>
            <!-- 控制栏 -->
        </Grid.RowDefinitions>
        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Background="{DynamicResource RegionBrush}">
            <TextBlock Text="ACPlay" Margin="10,5" FontSize="16" Foreground="White"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- 打开文件（内置图标：FolderOpenGeometry） -->
                <Button x:Name="BtnOpen" Margin="5" Click="BtnOpen_Click" 
                        Style="{StaticResource ButtonPrimary}"
                        hc:IconElement.Geometry="{StaticResource MaskGeometry}"/>

                <!-- 置顶（内置图标：PinGeometry） -->
                <ToggleButton x:Name="BtnTopMost" Margin="5" 
                              Checked="BtnTopMost_Checked" Unchecked="BtnTopMost_Unchecked"
                              Style="{StaticResource ToggleButtonPrimary}"
                              hc:IconElement.Geometry="{StaticResource BaoGaoGeometry}"/>
            </StackPanel>
        </DockPanel>

        <!-- 视频区 -->
        <Grid x:Name="VideoGrid" Grid.Row="1" Background="Black">
            <MediaElement x:Name="mediaElement" Stretch="Uniform" LoadedBehavior="Manual" 
                          MediaOpened="mediaElement_MediaOpened" MediaEnded="mediaElement_MediaEnded"/>
            <!-- 中央播放按钮 -->
            <Button x:Name="BtnCenterPlay" Content="▶" FontSize="40" Visibility="Collapsed" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Click="BtnCenterPlay_Click" Style="{StaticResource ButtonPrimary}"
                    Foreground="White" Background="Transparent" BorderBrush="White"/>
        </Grid>

        <!-- 控制栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Background="{DynamicResource RegionBrush}" 
                    Margin="10" HorizontalAlignment="Stretch">
            <!-- 播放/暂停（内置图标：PlayGeometry / PauseGeometry） -->
            <Button x:Name="BtnPlayPause" Margin="5" Click="BtnPlayPause_Click" 
                    Style="{StaticResource ButtonPrimary}"
                    hc:IconElement.Geometry="{StaticResource VideoStopGeometry}"/>

            <!-- 循环模式（默认：RepeatGeometry；单曲循环：自定义LoopSingleGeometry） -->
            <Button x:Name="BtnLoop" Margin="5" Click="BtnLoop_Click" 
                    Style="{StaticResource ButtonPrimary}"
                    hc:IconElement.Geometry="{StaticResource LoopSingleGeometry}"/>

            <!-- 倍速选择 -->
            <ComboBox x:Name="CmbSpeed" Width="80" Margin="5" SelectedIndex="0" 
                      SelectionChanged="CmbSpeed_SelectionChanged"
                      Style="{StaticResource ComboBoxExtend}">
                <ComboBoxItem>1.0×</ComboBoxItem>
                <ComboBoxItem>1.5×</ComboBoxItem>
                <ComboBoxItem>2.0×</ComboBoxItem>
            </ComboBox>

            <!-- 时间显示 -->
            <TextBlock x:Name="TxtTime" Margin="20,0" VerticalAlignment="Center" 
                       Text="00:00:00 / 00:00:00"/>

            <!-- 音量控制（内置图标：VolumeGeometry / VolumeMuteGeometry） -->
            <Slider x:Name="SliderVolume" Width="150" Margin="20,0" Minimum="0" Maximum="1" 
                    Value="0.5" ValueChanged="SliderVolume_ValueChanged"  />
            <Button x:Name="BtnMute" Margin="5" Click="BtnMute_Click" 
                    Style="{StaticResource ButtonPrimary}"
                    hc:IconElement.Geometry="{StaticResource VideoStartGeometry}"/>

            <!-- 全屏（内置图标：FullScreenGeometry） -->
            <Button x:Name="BtnFullScreen" Margin="5" Click="BtnFullScreen_Click" 
                    Style="{StaticResource ButtonPrimary}"
                    hc:IconElement.Geometry="{StaticResource FullScreenGeometry}"/>
        </StackPanel>

        <!-- 进度条 -->
        <Slider x:Name="sliderProgress" Grid.Row="1" VerticalAlignment="Bottom" 
                Margin="10,0" Minimum="0"  Maximum="100" Value="0"  primitives:Thumb.DragStarted="SliderProgress_DragStarted" 
                primitives:Thumb.DragCompleted="SliderProgress_DragCompleted"/>
    </Grid>
</hc:Window>