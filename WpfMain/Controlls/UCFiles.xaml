<UserControl x:Class="WpfMain.Controlls.UCFiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfMain.Controlls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:entity="clr-namespace:WpfMain.Entity"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" DataContext="{Binding}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <hc:Divider Content="拍照" HorizontalContentAlignment="Left" Foreground="White" Margin="0"/>
            <ListBox hc:ScrollViewer.IsInertiaEnabled="False" Margin="0" BorderThickness="0"  Height="180"  ItemsPanel="{StaticResource FluidMoveBehaviorWrapPanelItemsPanelTemplate}" Style="{StaticResource WrapPanelHorizontalListBox}"  ItemsSource="{Binding ParentData.Result.Images, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="0"/>
                </ListBox.Background>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type entity:ImageItem}">
                        <hc:Card  BorderThickness="0" Margin="8" Effect="{StaticResource EffectShadow2}" MaxWidth="120"  Tag="{Binding}"  Footer="{Binding Name}" MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                            <hc:Card.Background>
                                <SolidColorBrush Color="White" Opacity="0.2"/>
                            </hc:Card.Background>
                            <Border CornerRadius="4,4,0,0" Style="{StaticResource BorderClip}">
                                <Image Width="120" Height="100" Source="{Binding ImageSource}" Stretch="Uniform"/>
                                <Border.ContextMenu>
                                    <ContextMenu Width="120">
                                        <MenuItem Header="删除" x:Name="deleImg" Click="MenuItem_OnClick" ItemsSource="{Binding}">
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                            <hc:Card.FooterTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="1">
                                        <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBlockDefault}" Foreground="White" Text="{Binding }" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </hc:Card.FooterTemplate>
                        </hc:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <hc:Divider Content="视频" HorizontalContentAlignment="Left" Foreground="White" Margin="0"/>
            <ListBox  Grid.Row="1" hc:ScrollViewer.IsInertiaEnabled="True" Margin="0" BorderThickness="0"  Height="180"  ItemsPanel="{StaticResource FluidMoveBehaviorWrapPanelItemsPanelTemplate}" HorizontalAlignment="Left" Style="{StaticResource WrapPanelHorizontalListBox}"  ItemsSource="{Binding ParentData.Result.Vedios, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="0"/>
                </ListBox.Background>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type entity:ImageItem}">
                        <hc:Card  BorderThickness="0" Margin="8" Effect="{StaticResource EffectShadow2}" MaxWidth="120" Tag="{Binding}"  Footer="{Binding Name}" MouseLeftButtonDown="UIElement_Video_OnMouseLeftButtonDown">
                            <hc:Card.Background>
                                <SolidColorBrush Color="White" Opacity="0.2"/>
                            </hc:Card.Background>
                            <Border CornerRadius="4,4,0,0" Style="{StaticResource BorderClip}">
                                <MediaElement Width="120" Height="100" Source="{Binding Source}" Stretch="Uniform"/>
                                <Border.ContextMenu>
                                    <ContextMenu Width="120">
                                        <MenuItem Header="删除" x:Name="deleImg" Click="MenuItem_OnClick" ItemsSource="{Binding}">
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                            <hc:Card.FooterTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="1">
                                        <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBlockDefault}" Foreground="White" Text="{Binding }" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </hc:Card.FooterTemplate>
                        </hc:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
