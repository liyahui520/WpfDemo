<Window x:Class="OpenCv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenCv"
        xmlns:controls="clr-namespace:OpenCv.Controls"
        mc:Ignorable="d"
        Title="OpenCV 摄像头测试系统" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30">
    
    <Window.Resources>
        <!-- 现代化样式定义 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E90FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0066CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="OpenCV 摄像头测试系统" 
                          Style="{StaticResource HeaderTextStyle}" 
                          FontSize="20" 
                          VerticalAlignment="Center"/>
                <TextBlock Text="- 高性能摄像头预览与录像解决方案" 
                          Style="{StaticResource InfoTextStyle}" 
                          VerticalAlignment="Center" 
                          Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 摄像头预览区域 -->
            <Border Grid.Column="0" 
                    Background="#FF3F3F46" 
                    CornerRadius="8" 
                    Margin="0,0,5,0">
                <controls:CameraPreviewControl x:Name="CameraPreview" 
                                             Margin="10"/>
            </Border>

            <!-- 控制面板 -->
            <ScrollViewer Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto"
                         Margin="5,0,0,0">
                <StackPanel>
                    
                    <!-- 设备信息 -->
                    <GroupBox Header="设备信息" Style="{StaticResource GroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="可用设备:" Style="{StaticResource InfoTextStyle}"/>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DeviceComboBox" 
                                         Grid.Column="0"
                                         Margin="0,0,5,0"
                                         SelectionChanged="DeviceComboBox_SelectionChanged"/>
                                <Button x:Name="RefreshDevicesButton"
                                       Grid.Column="1"
                                       Content="🔄"
                                       Style="{StaticResource ModernButtonStyle}"
                                       ToolTip="刷新设备列表"
                                       Width="35"
                                       Height="25"
                                       Margin="0"
                                       Padding="0"
                                       FontSize="12"
                                       Click="RefreshDevicesButton_Click"/>
                            </Grid>
                            
                            <TextBlock Text="设备状态:" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="DeviceStatusText" 
                                      Text="未连接" 
                                      Style="{StaticResource InfoTextStyle}"
                                      Foreground="#FFFF6B6B"/>
                            
                            <TextBlock Text="分辨率:" Style="{StaticResource InfoTextStyle}"/>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ResolutionComboBox" 
                                         Grid.Column="0"
                                         Margin="0,0,5,0"
                                         SelectionChanged="ResolutionComboBox_SelectionChanged"
                                         IsEnabled="False"/>
                                <Button x:Name="ApplyResolutionButton"
                                       Grid.Column="1"
                                       Content="✓"
                                       Style="{StaticResource ModernButtonStyle}"
                                       ToolTip="应用分辨率"
                                       Width="35"
                                       Height="25"
                                       Margin="0"
                                       Padding="0"
                                       FontSize="12"
                                       IsEnabled="False"
                                       Click="ApplyResolutionButton_Click"/>
                            </Grid>
                            
                            <!-- 分辨率设置进度指示器 -->
                            <StackPanel x:Name="ResolutionProgressPanel" 
                                       Orientation="Horizontal" 
                                       Margin="5,2"
                                       Visibility="Collapsed">
                                <ProgressBar x:Name="ResolutionProgressBar"
                                           Width="120"
                                           Height="4"
                                           IsIndeterminate="True"
                                           Foreground="#FF4CAF50"
                                           Background="#FF3F3F46"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ResolutionProgressText"
                                          Text="正在设置分辨率..."
                                          Style="{StaticResource InfoTextStyle}"
                                          FontSize="10"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Text="当前分辨率:" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="ResolutionText" 
                                      Text="未知" 
                                      Style="{StaticResource InfoTextStyle}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 性能监控 -->
                    <GroupBox Header="性能监控" Style="{StaticResource GroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="帧率 (FPS):" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="FpsText" 
                                      Text="0.0" 
                                      Style="{StaticResource InfoTextStyle}"
                                      Foreground="#FF4ECDC4"/>
                            
                            <TextBlock Text="CPU 使用率:" Style="{StaticResource InfoTextStyle}"/>
                            <ProgressBar x:Name="CpuProgressBar" 
                                        Height="20" 
                                        Margin="5"
                                        Background="#FF2D2D30"
                                        Foreground="#FFFF6B6B"/>
                            <TextBlock x:Name="CpuText" 
                                      Text="0%" 
                                      Style="{StaticResource InfoTextStyle}"
                                      HorizontalAlignment="Center"/>
                            
                            <TextBlock Text="内存使用:" Style="{StaticResource InfoTextStyle}"/>
                            <ProgressBar x:Name="MemoryProgressBar" 
                                        Height="20" 
                                        Margin="5"
                                        Background="#FF2D2D30"
                                        Foreground="#FF45B7D1"/>
                            <TextBlock x:Name="MemoryText" 
                                      Text="0 MB" 
                                      Style="{StaticResource InfoTextStyle}"
                                      HorizontalAlignment="Center"/>
                            
                            <!-- 系统健康状态 -->
                            <TextBlock Text="系统状态" Style="{StaticResource InfoTextStyle}" FontWeight="Bold" Margin="0,10,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SystemHealthIndicator" Width="12" Height="12" Fill="Green" Margin="0,0,5,0"/>
                                <TextBlock x:Name="SystemStatusText" Text="正常运行" Foreground="Green" Style="{StaticResource InfoTextStyle}"/>
                            </StackPanel>
                            
                            <!-- 错误统计 -->
                            <TextBlock Text="错误统计" Style="{StaticResource InfoTextStyle}" FontWeight="Bold" Margin="0,10,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="总错误数:" FontSize="10" Foreground="#FFCCCCCC"/>
                                    <TextBlock x:Name="TotalErrorsText" Text="0" FontWeight="Bold" Foreground="Red"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="严重错误:" FontSize="10" Foreground="#FFCCCCCC"/>
                                    <TextBlock x:Name="CriticalErrorsText" Text="0" FontWeight="Bold" Foreground="DarkRed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 录像控制 -->
                    <GroupBox Header="录像控制" Style="{StaticResource GroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="录像格式:" Style="{StaticResource InfoTextStyle}"/>
                            <ComboBox x:Name="VideoFormatComboBox" 
                                     Margin="5"
                                     SelectedIndex="0">
                                <ComboBoxItem Content="MP4 (H.264)"/>
                                <ComboBoxItem Content="AVI (MJPG)"/>
                                <ComboBoxItem Content="MOV (H.264)"/>
                            </ComboBox>
                            
                            <TextBlock Text="录像质量:" Style="{StaticResource InfoTextStyle}"/>
                            <ComboBox x:Name="QualityComboBox" 
                                     Margin="5"
                                     SelectedIndex="1">
                                <ComboBoxItem Content="低质量 (480p)"/>
                                <ComboBoxItem Content="标准质量 (720p)"/>
                                <ComboBoxItem Content="高质量 (1080p)"/>
                            </ComboBox>
                            
                            <TextBlock Text="录像状态:" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="RecordingStatusText" 
                                      Text="未录像" 
                                      Style="{StaticResource InfoTextStyle}"/>
                            
                            <TextBlock Text="录像时长:" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="RecordingTimeText" 
                                      Text="00:00:00" 
                                      Style="{StaticResource InfoTextStyle}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 操作按钮 -->
                    <GroupBox Header="操作控制" Style="{StaticResource GroupBoxStyle}">
                        <StackPanel>
                            <Button x:Name="StartStopButton" 
                                   Content="开始预览" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Click="StartStopButton_Click"/>
                            
                            <Button x:Name="RecordButton" 
                                   Content="开始录像" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#FFFF6B6B"
                                   Click="RecordButton_Click"/>
                            
                            <Button x:Name="SnapshotButton" 
                                   Content="拍照" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#FF4ECDC4"
                                   Click="SnapshotButton_Click"/>
                            
                            <Button x:Name="SettingsButton" 
                                   Content="设置" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#FF95A5A6"
                                   Click="SettingsButton_Click"/>
                            
                            <Button x:Name="TestCameraButton" 
                                   Content="测试摄像头" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#FFFF9500"
                                   Click="TestCameraButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 日志信息 -->
                    <GroupBox Header="系统日志" Style="{StaticResource GroupBoxStyle}">
                        <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogTextBox" 
                                    Background="Transparent"
                                    Foreground="#FFCCCCCC"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    FontFamily="Consolas"
                                    FontSize="10"/>
                        </ScrollViewer>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#FF1E1E1E" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" 
                          Text="就绪" 
                          Style="{StaticResource InfoTextStyle}"
                          VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="版本: 1.0.0" 
                              Style="{StaticResource InfoTextStyle}"
                              VerticalAlignment="Center"/>
                    <Rectangle Width="1" 
                              Height="15" 
                              Fill="#FF3F3F46" 
                              Margin="10,0"/>
                    <TextBlock x:Name="TimeText" 
                              Style="{StaticResource InfoTextStyle}"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
