<UserControl x:Class="OpenCv.Controls.CameraPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenCv.Controls"
             xmlns:converters="clr-namespace:OpenCv.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Black">
    
    <UserControl.Resources>
        <!-- 转换器定义 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 摄像头预览区域 -->
        <Border Grid.Row="0" 
                Background="Black" 
                BorderBrush="#FF3F3F46" 
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <!-- 视频显示控件 - 使用ViewBox确保等比例缩放 -->
                <Viewbox Stretch="Uniform" 
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Image x:Name="VideoImage" 
                           Source="{Binding CurrentFrame, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           SnapsToDevicePixels="True"/>
                </Viewbox>

                <!-- 无信号提示 -->
                <StackPanel x:Name="NoSignalPanel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSignal, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <TextBlock Text="📷" 
                              FontSize="48" 
                              Foreground="#FF666666"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="无摄像头信号" 
                              FontSize="16" 
                              Foreground="#FF999999"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="请检查摄像头连接" 
                              FontSize="12" 
                              Foreground="#FF666666"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 录制指示器 -->
                <Border x:Name="RecordingIndicator"
                        Background="#FFFF0000"
                        CornerRadius="10"
                        Width="20" Height="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Visibility="Collapsed">
                    <Ellipse Fill="White" 
                            Width="8" Height="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- 拍照闪光效果 -->
                <Border x:Name="FlashEffect"
                        Background="White"
                        Opacity="0"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>


    </Grid>
</UserControl>