<UserControl x:Class="CuPrint.PrintControlls.PrintImg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CuPrint.PrintControlls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:entity1="clr-namespace:Entity.Entity;assembly=Entity"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Width="750" Background="White"  Margin="0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ListBox hc:ScrollViewer.IsInertiaEnabled="False" x:Name="ImgListBox" Margin="0" BorderThickness="0"  Height="180" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" FocusVisualStyle="{StaticResource FocusVisualRadius0Margin0}" ItemContainerStyle="{StaticResource CustomListBoxItemStyle}" ItemsPanel="{StaticResource FluidMoveBehaviorWrapPanelItemsPanelTemplate}" Style="{StaticResource WrapPanelHorizontalListBox}"  ItemsSource="{Binding ParentData.Result.Images}">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="0"/>
                </ListBox.Background>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type entity1:ImageItem}">
                        <hc:Card Margin="8" BorderThickness="0" Effect="{StaticResource EffectShadow2}"  MaxWidth="120" Tag="{Binding}"  Footer="{Binding Name}">
                            <hc:Card.Background>
                                <SolidColorBrush Color="White" Opacity="0.2"/>
                            </hc:Card.Background>
                            <Border CornerRadius="4,4,0,0" Style="{StaticResource BorderClip}">
                                <Image Width="120" Height="100" Source="{Binding ImageSource}" Stretch="Uniform"/> 
                            </Border> 
                        </hc:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </WrapPanel>
    </Grid>
</UserControl>
