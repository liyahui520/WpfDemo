<UserControl x:Class="CuPrint.PrintControlls.PrintFoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CuPrint.PrintControlls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             DataContext="{Binding tInfo}"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="700" Width="750" Background="White" Margin="0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="检查医生" Style="{StaticResource TextBlockDefault}" FontSize="14"/>
            <Border Width="150" Margin="5,0,5,0" BorderThickness="0,0,0,0.6" BorderBrush="Black">
                <TextBlock x:Name="customer" HorizontalAlignment="Center" Text="{Binding DCOperation}" VerticalAlignment="Center"  FontSize="14"/>
            </Border>

        </WrapPanel>
        <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom"  HorizontalAlignment="Right">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="第1页" x:Name="pageCount" Style="{StaticResource TextBlockDefault}" FontSize="10"/>

        </WrapPanel>
    </Grid>
</UserControl>
