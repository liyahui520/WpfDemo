<UserControl x:Class="CuPrint.PrintControlls.PrintHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CuPrint.PrintControlls" DataContext="{Binding tInfo}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/> 
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="hospitalName" HorizontalAlignment="Center" Text="测试医院" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"></TextBlock>
        <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="宠    主" Style="{StaticResource TextBlockDefault}"/> 
            <TextBlock x:Name="customer" HorizontalAlignment="Center" Text="{Binding Customer}" VerticalAlignment="Center"  FontSize="14" Width="150" TextDecorations="Underline"></TextBlock>
        </WrapPanel>
    </Grid>
</UserControl>
