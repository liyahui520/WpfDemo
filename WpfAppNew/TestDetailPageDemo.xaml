<Window x:Class="WpfAppNew.TestDetailPageDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfAppNew.Controlls"
        Title="TestInfo详情页面演示" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐾" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="宠物检查详情页面演示" 
                          FontSize="18" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          VerticalAlignment="Center"/>
                <Button Content="加载测试数据" 
                       Width="120" 
                       Height="32" 
                       Margin="20,0,0,0"
                       Background="#3498DB"
                       Foreground="White"
                       BorderThickness="0"
                       Click="LoadTestData_Click"/>
            </StackPanel>
        </Border>

        <!-- 详情页面内容 -->
        <Border Grid.Row="1" Margin="16" Background="White" 
               BorderBrush="#E0E0E0" BorderThickness="1" 
               CornerRadius="8">
            <controls:TestInfoDetailPage x:Name="DetailPage"/>
        </Border>
    </Grid>
</Window>