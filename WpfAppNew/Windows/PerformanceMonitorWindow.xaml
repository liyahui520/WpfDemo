<hc:Window xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="WpfAppNew.Windows.PerformanceMonitorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppNew.Windows"
             mc:Ignorable="d" 
             Title="性能监控与日志信息" 
             Height="600" Width="800"
             WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 样式定义 -->
        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="性能监控与日志信息" 
                         Style="{StaticResource HeaderTextStyle}" 
                         FontSize="20" 
                         VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 性能监控 -->
            <GroupBox Grid.Column="0" Header="性能监控" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="帧率 (FPS):" Style="{StaticResource InfoTextStyle}"/>
                    <TextBlock x:Name="FpsText" 
                             Text="0.0" 
                             Style="{StaticResource InfoTextStyle}"
                             Foreground="#FF4ECDC4"
                             FontSize="14"
                             FontWeight="Bold"/>

                    <TextBlock Text="CPU 使用率:" Style="{StaticResource InfoTextStyle}" Margin="5,10,5,2"/>
                    <ProgressBar x:Name="CpuProgressBar" 
                               Height="20" 
                               Margin="5"
                               Background="#FF2D2D30"
                               Foreground="#FFFF6B6B"/>
                    <TextBlock x:Name="CpuText" 
                             Text="0%" 
                             Style="{StaticResource InfoTextStyle}"
                             HorizontalAlignment="Center"/>

                    <TextBlock Text="内存使用:" Style="{StaticResource InfoTextStyle}" Margin="5,10,5,2"/>
                    <ProgressBar x:Name="MemoryProgressBar" 
                               Height="20" 
                               Margin="5"
                               Background="#FF2D2D30"
                               Foreground="#FF45B7D1"/>
                    <TextBlock x:Name="MemoryText" 
                             Text="0 MB" 
                             Style="{StaticResource InfoTextStyle}"
                             HorizontalAlignment="Center"/>

                    <!-- 系统健康状态 -->
                    <TextBlock Text="系统状态" Style="{StaticResource InfoTextStyle}" FontWeight="Bold" Margin="0,10,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SystemHealthIndicator" Width="12" Height="12" Fill="Green" Margin="0,0,5,0"/>
                        <TextBlock x:Name="SystemStatusText" Text="正常运行" Foreground="Green" Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- 错误统计 -->
                    <TextBlock Text="错误统计" Style="{StaticResource InfoTextStyle}" FontWeight="Bold" Margin="0,10,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="总错误数:" FontSize="10" Foreground="#FFCCCCCC"/>
                            <TextBlock x:Name="TotalErrorsText" Text="0" FontWeight="Bold" Foreground="Red"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="严重错误:" FontSize="10" Foreground="#FFCCCCCC"/>
                            <TextBlock x:Name="CriticalErrorsText" Text="0" FontWeight="Bold" Foreground="DarkRed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 日志信息 -->
            <GroupBox Grid.Column="1" Header="系统日志" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ClearLogButton" Content="清空日志" Click="ClearLogButton_Click" 
                                Width="80" Height="25" FontSize="12"/>
                        <Button x:Name="SaveLogButton" Content="保存日志" Click="SaveLogButton_Click" 
                                Width="80" Height="25" FontSize="12" Margin="10,0,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox" 
                               Background="Transparent"
                               Foreground="#FFCCCCCC"
                               BorderThickness="0"
                               IsReadOnly="True"
                               TextWrapping="NoWrap"
                               FontFamily="Consolas"
                               FontSize="11"/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>