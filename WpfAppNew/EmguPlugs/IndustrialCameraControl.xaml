<UserControl x:Class="WpfAppNew.EmguPlugs.IndustrialCameraControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:Tools.Extend.Converters;assembly=Tools"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200" 
             Background="Black">
    
    <!-- 工业相机控制界面 -->
    <!-- 包含预览区域、控制面板、参数设置等功能模块 -->
    
    <UserControl.Resources>
        <!-- 转换器资源定义 -->
        <converters:BoolToConnectionColorConverter x:Key="BoolToConnectionColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 设备选择区域已移至主界面左侧控制面板 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 设备选择控件已移除，由外部控制 -->
                </StackPanel>
                
                <!-- 连接状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Margin="0,0,5,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToConnectionColorConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
                
                <!-- 主要操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="{Binding ConnectButtonText}" 
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ButtonPrimary}" Margin="0,0,5,0"/>
                    <Button x:Name="StartPreviewButton" Content="开始预览" 
                            Command="{Binding StartPreviewCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Style="{StaticResource ButtonSuccess}" Margin="0,0,5,0"/>
                    <Button x:Name="StopPreviewButton" Content="停止预览" 
                            Command="{Binding StopPreviewCommand}"
                            IsEnabled="{Binding IsPreviewRunning}"
                            Style="{StaticResource ButtonWarning}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 预览区域 -->
            <Border Grid.Column="0" Background="{DynamicResource SecondaryRegionBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 预览工具栏 -->
                    <Border Grid.Row="0" Background="{DynamicResource ThirdRegionBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 预览控制 - 拍照和录像按钮已移至主界面左侧控制面板 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 拍照和录像按钮已移除，由外部控制 -->
                            </StackPanel>
                            
                            <!-- 录像状态 - 优化：移除动画以提升性能 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse Width="8" Height="8" Fill="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="录像中" VerticalAlignment="Center" FontWeight="Medium" Foreground="Red"/>
                                <TextBlock Text="{Binding RecordingDuration, StringFormat='{}{0:mm\\:ss}'}" 
                                           VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Consolas"/>
                            </StackPanel>
                            
                            <!-- 缩放控制 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="适应窗口" Command="{Binding FitToWindowCommand}" 
                                        Style="{StaticResource ButtonDefault}" Margin="0,0,5,0"/>
                                <Button Content="实际大小" Command="{Binding ActualSizeCommand}" 
                                        Style="{StaticResource ButtonDefault}" Margin="0,0,5,0"/>
                                <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" 
                                           VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 图像预览区域 -->
                    <!-- 优化：移除滚动条，设置等比例显示并上下居中，使用Linear缩放提升性能 -->
                    <Border Grid.Row="1" x:Name="PreviewContainer" Background="Black">
                        <Image x:Name="PreviewImage" 
                               Source="{Binding PreviewImageSource}"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="Linear"/>
                    </Border>
                    
                    <!-- 预览信息栏 -->
                    <Border Grid.Row="2" Background="{DynamicResource ThirdRegionBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 图像信息 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="分辨率:" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ImageResolution}" FontFamily="Consolas" Margin="0,0,15,0"/>
                                <TextBlock Text="格式:" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ImageFormat}" FontFamily="Consolas" Margin="0,0,15,0"/>
                                <TextBlock Text="帧率:" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding FrameRate, StringFormat='{}{0:F1} FPS'}" FontFamily="Consolas"/>
                            </StackPanel>
                            
                            <!-- 性能信息 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="CPU:" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F1}%'}" FontFamily="Consolas" Margin="0,0,15,0"/>
                                <TextBlock Text="内存:" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding MemoryUsage}" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            
            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
            
            <!-- 控制面板 -->
            <Border Grid.Column="2" Background="{DynamicResource SecondaryRegionBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="5" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        
                        <!-- 显微镜控制 -->
                        <hc:Card Header="显微镜控制" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 放大倍数 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="放大倍数:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="MagnificationSlider" 
                                            Minimum="1" Maximum="1000" Value="{Binding MagnificationValue}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MagnificationValue, StringFormat='{}{0:F0}x'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 预设放大倍数 -->
                                <WrapPanel Margin="0,5">
                                    <Button Content="4x" Command="{Binding SetMagnificationCommand}" CommandParameter="4" 
                                            Style="{StaticResource ButtonDefault}" Margin="0,0,5,5"/>
                                    <Button Content="10x" Command="{Binding SetMagnificationCommand}" CommandParameter="10" 
                                            Style="{StaticResource ButtonDefault}" Margin="0,0,5,5"/>
                                    <Button Content="40x" Command="{Binding SetMagnificationCommand}" CommandParameter="40" 
                                            Style="{StaticResource ButtonDefault}" Margin="0,0,5,5"/>
                                    <Button Content="100x" Command="{Binding SetMagnificationCommand}" CommandParameter="100" 
                                            Style="{StaticResource ButtonDefault}" Margin="0,0,5,5"/>
                                    <Button Content="400x" Command="{Binding SetMagnificationCommand}" CommandParameter="400" 
                                            Style="{StaticResource ButtonDefault}"/>
                                </WrapPanel>
                                
                                <!-- 对焦控制 -->
                                <Separator Margin="0,10"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="对焦:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="FocusSlider" 
                                            Minimum="0" Maximum="1" Value="{Binding FocusValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FocusValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="自动对焦" IsChecked="{Binding IsAutoFocusEnabled}"/>
                                    <Button Grid.Column="1" Content="执行对焦" Command="{Binding AutoFocusCommand}"
                                            IsEnabled="{Binding CanAutoFocus}" Style="{StaticResource ButtonPrimary}"/>
                                </Grid>
                                
                                <!-- 清晰度指示 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="清晰度:" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding SharpnessScore, Mode=OneWay}" Maximum="1" 
                                                 Height="20" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </hc:Card>
                        
                        <!-- 光源控制 -->
                        <hc:Card Header="光源控制" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 亮度控制 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="亮度:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="BrightnessSlider" 
                                            Minimum="0" Maximum="1" Value="{Binding LightBrightness}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnBrightnessChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LightBrightness, StringFormat='{}{0:P0}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 色温控制 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="色温:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="TemperatureSlider" 
                                            Minimum="2700" Maximum="6500" Value="{Binding LightTemperature}"
                                            SmallChange="100" LargeChange="500" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LightTemperature, StringFormat='{}{0:F0}K'}" 
                                               VerticalAlignment="Center" MinWidth="50" FontFamily="Consolas"/>
                                </Grid>
                            </StackPanel>
                        </hc:Card>
                        
                        <!-- 相机参数 -->
                        <hc:Card Header="相机参数" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 曝光时间 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="曝光:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="ExposureSlider" 
                                            Minimum="0" Maximum="1" Value="{Binding ExposureValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnExposureChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ExposureValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 增益 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="增益:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="GainSlider" 
                                            Minimum="0" Maximum="1" Value="{Binding GainValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnGainChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GainValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 白平衡 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="白平衡:" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <CheckBox Content="自动" IsChecked="{Binding IsAutoWhiteBalance}" Margin="0,0,10,0"/>
                                        <Button Content="执行" Command="{Binding WhiteBalanceCommand}"
                                                IsEnabled="{Binding IsAutoWhiteBalance, Converter={StaticResource InverseBoolConverter}}"
                                                Style="{StaticResource ButtonDefault}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </hc:Card>
                        
                        <!-- 图像处理 -->
                        <hc:Card Header="图像处理" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 对比度 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="对比度:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="ContrastSlider" 
                                            Minimum="0" Maximum="2" Value="{Binding ContrastValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnContrastChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ContrastValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 饱和度 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="饱和度:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SaturationSlider" 
                                            Minimum="0" Maximum="2" Value="{Binding SaturationValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnSaturationChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SaturationValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 锐化 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="锐化:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SharpnessSlider" 
                                            Minimum="0" Maximum="2" Value="{Binding SharpnessValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnSharpnessChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SharpnessValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 伽马校正 -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="伽马:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="GammaSlider" 
                                            Minimum="0.1" Maximum="3.0" Value="{Binding GammaValue}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="10,0"
                                            ValueChanged="OnGammaChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GammaValue, StringFormat='{}{0:F2}'}" 
                                               VerticalAlignment="Center" MinWidth="40" FontFamily="Consolas"/>
                                </Grid>
                                
                                <!-- 降噪 -->
                                <CheckBox Content="启用降噪" IsChecked="{Binding IsNoiseReductionEnabled}" Margin="0,5"/>
                                
                                <!-- 重置按钮 -->
                                <Button Content="重置所有参数" Command="{Binding ResetParametersCommand}"
                                        Style="{StaticResource ButtonWarning}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </hc:Card>
                        
                        <!-- 焦点堆叠 -->
                        <hc:Card Header="焦点堆叠" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="启用焦点堆叠" IsChecked="{Binding IsFocusStackingEnabled}" Margin="0,5"/>
                                
                                <Grid Margin="0,5" IsEnabled="{Binding IsFocusStackingEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="步数:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="StackingStepsSlider" 
                                            Minimum="3" Maximum="50" Value="{Binding FocusStackingSteps}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FocusStackingSteps}" 
                                               VerticalAlignment="Center" MinWidth="30" FontFamily="Consolas"/>
                                </Grid>
                                
                                <Button Content="执行焦点堆叠" Command="{Binding PerformFocusStackingCommand}"
                                        IsEnabled="{Binding CanPerformFocusStacking}"
                                        Style="{StaticResource ButtonPrimary}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </hc:Card>
                        
                        <!-- 测量工具 -->
                        <hc:Card Header="测量工具" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标定状态:" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CalibrationStatus}" 
                                               VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Medium"/>
                                </Grid>
                                
                                <Button Content="执行标定" Command="{Binding CalibrateCommand}"
                                        Style="{StaticResource ButtonPrimary}" Margin="0,5"/>
                                
                                <Separator Margin="0,10"/>
                                
                                <Button Content="距离测量" Command="{Binding MeasureDistanceCommand}"
                                        IsEnabled="{Binding CanMeasure}"
                                        Style="{StaticResource ButtonDefault}" Margin="0,5"/>
                                
                                <Button Content="角度测量" Command="{Binding MeasureAngleCommand}"
                                        IsEnabled="{Binding CanMeasure}"
                                        Style="{StaticResource ButtonDefault}" Margin="0,5"/>
                                
                                <Button Content="面积测量" Command="{Binding MeasureAreaCommand}"
                                        IsEnabled="{Binding CanMeasure}"
                                        Style="{StaticResource ButtonDefault}" Margin="0,5"/>
                            </StackPanel>
                        </hc:Card>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 操作状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="状态:" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding OperationStatus}" FontWeight="Medium"/>
                </StackPanel>
                
                <!-- 进度条 -->
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100" 
                             Height="16" Margin="20,0" 
                             Visibility="{Binding IsOperationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                
                <!-- 时间信息 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="运行时间:" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding RunningTime, StringFormat='{}{0:hh\\:mm\\:ss}'}" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>