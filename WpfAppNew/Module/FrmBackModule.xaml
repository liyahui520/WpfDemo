<Window x:Class="WpfAppNew.Module.FrmBackModule"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:local="clr-namespace:WpfAppNew.Module"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           WindowStartupLocation="CenterScreen" WindowStyle="None" 
           BorderThickness="0" Margin="0" Padding="0"
           d:DesignHeight="450" d:DesignWidth="800">
    <Window.Background>
        <ImageBrush ImageSource="pack://SiteOfOrigin:,,,/Static/Images/background.jpg"  Opacity="0.9"/>
    </Window.Background>
    <Grid Margin="0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions> 
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1"  HorizontalAlignment="Left" VerticalAlignment="Center">
                <hc:SimpleText x:Name="title" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,0,0,0"></hc:SimpleText>
            </StackPanel>
            <StackPanel Grid.Column="0"  HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="5" Style="{StaticResource ButtonOpacityCustom}" Click="ButtonBase_OnClick" hc:IconElement.Geometry="{StaticResource LeftGeometry}" hc:BorderElement.CornerRadius="5" Foreground="White" Effect="{StaticResource EffectShadow5}" BorderThickness="0" Content="返回上一步"/> 
            </StackPanel> 
        </Grid>
        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0" Padding="0">
            <UserControl x:Name="Control"></UserControl>
        </Border>
        <!--<petModule:FrmPet Grid.Row="1" />-->
    </Grid>
</Window>
