<UserControl x:Class="WpfAppNew.Module.FrmHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppNew.Module"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1800"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 样式资源定义 -->
            <Style x:Key="ModernCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#34495E"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#3498DB"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            
            <Style x:Key="ContentTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#BDC3C7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
            
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    BorderThickness="1" 
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- DataGrid行样式 - 添加鼠标悬停效果 -->
            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Height" Value="45"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#4A90E2"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#3498DB"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="#2980B9"/>
                        <Setter Property="Foreground" Value="White"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            
            <!-- DataGrid单元格样式 -->
            <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <Grid Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部查询条件区域 -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" BorderThickness="2,2,2,1"
                    BorderBrush="#4A90E2" Background="#2C3E50" Margin="5,5,5,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 查询条件控件 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 日期范围 -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="开始日期" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                            <DatePicker x:Name="StartDatePicker" Background="White" Foreground="Black" FontSize="12"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="结束日期" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                            <DatePicker x:Name="EndDatePicker" Background="White" Foreground="Black" FontSize="12"/>
                        </StackPanel>
                        
                        <!-- 关键词搜索 -->
                        <StackPanel Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Text="搜索内容" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="SearchTextBox" Background="White" Foreground="Black" FontSize="12" 
                                     hc:InfoElement.Placeholder="输入宠物名称、客户姓名或检查项目..."/>
                        </StackPanel>
                        
                        <!-- 操作按钮 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="🔍 搜索" x:Name="QueryButton" Click="QueryButton_OnClick"
                                    Style="{StaticResource ButtonInfo}" Foreground="White" FontWeight="Bold" FontSize="12"
                                    ToolTip="点击搜索历史记录" Cursor="Hand" Margin="0,0,10,0" Width="80" Height="32">
                                <Button.Effect>
                                    <DropShadowEffect Color="Blue" Direction="315" ShadowDepth="2" Opacity="0.5" BlurRadius="5"/>
                                </Button.Effect>
                            </Button>
                            
                            <Button Content="🔄 刷新" x:Name="RefreshButton" Click="RefreshButton_OnClick"
                                    Style="{StaticResource ButtonWarning}" Foreground="White" FontWeight="Bold" FontSize="12"
                                    ToolTip="刷新历史记录" Cursor="Hand" Width="80" Height="32">
                                <Button.Effect>
                                    <DropShadowEffect Color="Orange" Direction="315" ShadowDepth="2" Opacity="0.5" BlurRadius="5"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中间历史记录显示区域 -->
        <Border Grid.Row="1" CornerRadius="0" BorderThickness="2,1,2,1"
                BorderBrush="#4A90E2" Background="#2C3E50" Margin="5,0">
            <DataGrid x:Name="HistoryDataGrid" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      AlternatingRowBackground="#34495E"
                      RowBackground="#2C3E50"
                      Background="#2C3E50"
                      Foreground="White"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      RowHeight="45"
                      FontSize="12"
                      Margin="10"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}">
                    
                    <!-- 表格列定义 -->
                    <DataGrid.Columns>
                        <!-- 病历号 -->
                        <DataGridTextColumn Header="病历号" Binding="{Binding RecordNo}" Width="*" MinWidth="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 检查项目 -->
                        <DataGridTextColumn Header="检查项目" Binding="{Binding TestName}" Width="*" MinWidth="100">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 宠物姓名 -->
                        <DataGridTextColumn Header="宠物姓名" Binding="{Binding Pet}" Width="*" MinWidth="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 性别 -->
                        <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="60" MinWidth="50">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 年龄 -->
                        <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="*" MinWidth="50">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 种类 -->
                        <DataGridTextColumn Header="种类" Binding="{Binding Type}" Width="80" MinWidth="60">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 品种 -->
                        <DataGridTextColumn Header="品种" Binding="{Binding Variety}" Width="*" MinWidth="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 客户姓名 -->
                        <DataGridTextColumn Header="客户姓名" Binding="{Binding Customer}" Width="*" MinWidth="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 客户电话 -->
                        <DataGridTextColumn Header="客户电话" Binding="{Binding CustomerPhone}" Width="*" MinWidth="100">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 检查日期 -->
                        <DataGridTextColumn Header="检查日期" Binding="{Binding TestDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="*" MinWidth="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 检查医生 -->
                        <DataGridTextColumn Header="检查医生" Binding="{Binding DCOperation}" Width="*" MinWidth="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 大小 -->
                        <!--<DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="80" MinWidth="60">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>-->
                        
                        <!-- 数量 -->
                        <!--<DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="60" MinWidth="50">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>-->
                        
                        <!-- 绝育状态 -->
                        <DataGridTextColumn Header="绝育状态" Binding="{Binding Neuter}" Width="80" MinWidth="70">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        
                        <!-- 所见 -->
                        <DataGridTextColumn Header="镜检结果" Binding="{Binding See}" Width="*" MinWidth="150">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 报告路径 -->
                        <!--<DataGridTextColumn Header="报告路径" Binding="{Binding TestPath}" Width="150" MinWidth="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="ToolTip" Value="{Binding TestPath}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>-->
                        
                        <!-- 操作按钮列 -->
                        <DataGridTemplateColumn Header="操作" Width="200" MinWidth="180">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A90E2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="2">
                                        <!--<Button Content="查看详情" Click="Img_OnClick" Tag="{Binding}" Cursor="Hand"
                                                Width="80" Height="25" Margin="2,0"
                                                Background="#3498DB" Foreground="White" BorderBrush="#2980B9"
                                                ToolTip="查看检查图片" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2980B9"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>-->
                                        
                                        <!--<Button Content="🎥" Click="Video_OnClick" Tag="{Binding}"
                                                Width="30" Height="25" Margin="2,0"
                                                Background="#9B59B6" Foreground="White" BorderBrush="#8E44AD"
                                                ToolTip="查看检查视频" FontSize="10">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#8E44AD"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>-->

                                        <Button Content="检查报告" Click="ButtonBase_San_OnClick" Tag="{Binding}"
                                                Width="80" Height="25" Margin="2,0"
                                                Background="#27AE60" Foreground="White" BorderBrush="#229954"
                                                ToolTip="查看检查报告" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#229954"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        
                                        <Button Content="🗑删除" Click="Delete_OnClick" Tag="{Binding}"
                                                Width="70" Height="25" Margin="2,0"
                                                Background="#E74C3C" Foreground="White" BorderBrush="#C0392B"
                                                ToolTip="删除此记录" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C0392B"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" CornerRadius="0,0,8,8" BorderThickness="2,1,2,2"
                BorderBrush="#4A90E2" Background="#34495E" Margin="5,0,5,5">
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="就绪" 
                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" Text="共 0 条记录" 
                           Foreground="#BDC3C7" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- 状态栏 -->
        <Border Grid.Row="2" Margin="0,5,0,0" CornerRadius="8" Background="#34495E" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="就绪" Foreground="#2ECC71" FontSize="12" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" x:Name="RecordCountText" Text="共 0 条记录" Foreground="#BDC3C7" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>