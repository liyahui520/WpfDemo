<hc:Window x:Class="WpfAppNew.Controlls.UCOpenCvVideoPlayer"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
          xmlns:hc="https://handyorg.github.io/handycontrol"
          ShowNonClientArea="False"
          ShowTitle="True" 
          WindowStartupLocation="CenterScreen" 
          MouseLeftButtonDown="Border_MouseLeftButtonDown" 
          Margin="0" 
          Padding="0"
          mc:Ignorable="d" 
          WindowStyle="None"
          Width="800"
          Height="600"
          MinWidth="640"
          MinHeight="480"
          d:DesignHeight="450" 
          d:DesignWidth="800">
    
    <!-- 窗口背景 -->
    <Window.Background>
        <ImageBrush ImageSource="pack://SiteOfOrigin:,,,/Static/Images/background.jpg" Stretch="UniformToFill" />
    </Window.Background>
    
    <!-- 资源样式定义 -->
    <Window.Resources>
        <!-- 主题颜色定义 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00A8FF"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>
        
        <!-- 控制按钮样式 -->
        <Style TargetType="Button" x:Key="ControlButtonStyle">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#606060"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条样式 -->
        <Style TargetType="Slider" x:Key="ProgressSliderStyle">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    Height="{TemplateBinding Height}" 
                                    CornerRadius="4"/>
                            <Track Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{TemplateBinding Foreground}" 
                                                  Height="{TemplateBinding Height}"
                                                  Template="{x:Null}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" 
                                                  Template="{x:Null}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" 
                                           Background="{TemplateBinding Foreground}" 
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="{TemplateBinding Background}" 
                                                         Stroke="White" 
                                                         StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 音量滑块样式 -->
        <Style TargetType="Slider" x:Key="VolumeSliderStyle" BasedOn="{StaticResource ProgressSliderStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="100"/>
        </Style>

        <!-- 时间文本样式 -->
        <Style TargetType="TextBlock" x:Key="TimeTextStyle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="titleText" 
                               Text="视频播放器" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Button Click="MaxButton_Click" 
                            Width="35" Height="35" 
                            Style="{StaticResource ControlButtonStyle}" 
                            ToolTip="最大化/还原">
                        <TextBlock Text="⬜" FontSize="14"/>
                    </Button>
                    <Button Click="CloseButton_Click" 
                            Width="35" Height="35" 
                            Style="{StaticResource ControlButtonStyle}" 
                            ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="14"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 视频显示区域 -->
        <Grid Grid.Row="1" x:Name="videoContainer" Background="Black">
            <!-- 视频容器 - 使用Viewbox实现等比例缩放 -->
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Grid MinWidth="640" MinHeight="480">
                    <!-- OpenCV 视频显示控件 -->
                    <Image x:Name="videoImage" 
                           Width="640"
                           Height="480"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="VideoArea_MouseClick"/>
                </Grid>
            </Viewbox>
            
            <!-- 加载指示器 -->
            <Grid x:Name="loadingIndicator" Background="#80000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="60" Height="60" 
                             Stroke="{StaticResource PrimaryBrush}" 
                             StrokeThickness="4" 
                             StrokeDashArray="15,15">
                        <Ellipse.RenderTransform>
                            <RotateTransform CenterX="30" CenterY="30"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="loadingText" 
                               Text="正在加载视频..." 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="16" 
                               Margin="0,20,0,0" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 播放状态覆盖层 -->
            <Grid x:Name="playStateOverlay" Background="#40000000" Visibility="Collapsed">
                <Ellipse Width="80" Height="80" 
                         Fill="{StaticResource SecondaryBrush}" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="playStateIcon" 
                           Text="▶" 
                           FontSize="32" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- 控制面板 -->
        <Grid Grid.Row="2" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- 进度条区域 -->
            <Grid Grid.Row="0" Margin="22,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="currentTimeText" 
                           Grid.Column="0"
                           Text="00:00" 
                           Style="{StaticResource TimeTextStyle}"
                           Margin="0,0,10,0"/>

                <Slider x:Name="progressSlider" 
                        Grid.Column="1"
                        Style="{StaticResource ProgressSliderStyle}"
                        Minimum="0" Maximum="100" Value="0"
                        PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                        PreviewMouseMove="ProgressSlider_PreviewMouseMove"
                        PreviewMouseUp="ProgressSlider_PreviewMouseUp" Height="8"/>

                <TextBlock x:Name="totalTimeText" 
                           Grid.Column="2"
                           Text="00:00" 
                           Style="{StaticResource TimeTextStyle}"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- 控制按钮区域 -->
            <Grid Grid.Row="1" Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="openButton" 
                            Style="{StaticResource ControlButtonStyle}"
                            ToolTip="打开文件"
                            Click="OpenButton_Click">
                        <TextBlock Text="📁" FontSize="16"/>
                    </Button>

                    <Button x:Name="playButton" 
                            Style="{StaticResource ControlButtonStyle}"
                            ToolTip="播放/暂停"
                            Click="PlayButton_Click">
                        <TextBlock x:Name="playButtonIcon" Text="▶" FontSize="16"/>
                    </Button>

                    <Button x:Name="stopButton" 
                            Style="{StaticResource ControlButtonStyle}"
                            ToolTip="停止"
                            Click="StopButton_Click">
                        <TextBlock Text="⏹" FontSize="16"/>
                    </Button>

                    <Separator Width="2" Height="30" Background="{StaticResource SurfaceBrush}" Margin="10,0"/>

                    <TextBlock Text="🔊" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Slider x:Name="volumeSlider" 
                            Style="{StaticResource VolumeSliderStyle}"
                            ValueChanged="VolumeSlider_ValueChanged"
                            ToolTip="音量控制"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="fpsText" 
                               Text="FPS: 0" 
                               Style="{StaticResource TimeTextStyle}"
                               Margin="0,0,20,0"/>
                    
                    <TextBlock x:Name="resolutionText" 
                               Text="分辨率: 0x0" 
                               Style="{StaticResource TimeTextStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</hc:Window>