<UserControl x:Class="WpfAppNew.Controlls.UCFiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppNew.Controlls"
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             xmlns:entity1="clr-namespace:Entity.Entity;assembly=Entity"
             xmlns:styles="clr-namespace:Tools.Themes.Styles;assembly=Tools"
             xmlns:converters="clr-namespace:Tools.Extend.Converters;assembly=Tools"
             xmlns:extend="clr-namespace:Tools.Extend;assembly=Tools"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" DataContext="{Binding}">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <hc:Divider Grid.Row="0" Content="图像" HorizontalContentAlignment="Left" Foreground="White" Margin="0"/>
        <CheckBox Grid.Row="1" Foreground="White" Content="全选" IsChecked="False" Margin="10,3,0,0" Checked="ToggleButton_OnChecked" Unchecked="ToggleButton_OnUnchecked"/>
        <Grid Grid.Row="2">
            <ListBox hc:ScrollViewer.IsInertiaEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="8" VerticalAlignment="Stretch" x:Name="ImgListBox" SelectionMode="Single" Margin="0" BorderThickness="0"  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" FocusVisualStyle="{StaticResource FocusVisualRadius0Margin0}" ItemContainerStyle="{StaticResource CustomListBoxItemStyle}" ItemsPanel="{StaticResource FluidMoveBehaviorWrapPanelItemsPanelTemplate}" Style="{StaticResource WrapPanelHorizontalListBox}"  ItemsSource="{Binding ParentData.Result.Images, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="0"/>
                </ListBox.Background>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type entity1:ImageItem}">
                        <StackPanel Orientation="Horizontal" Margin="1" VerticalAlignment="Center">
                            <CheckBox Content="" IsChecked="{Binding IsSelected}" Margin="0" Padding="0"/>
                            <hc:Card Margin="8" BorderThickness="0" Effect="{StaticResource EffectShadow2}"  MaxWidth="120" Tag="{Binding}"  Footer="{Binding }" MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                                <hc:Card.Background>
                                    <SolidColorBrush Color="White" Opacity="0.2"/>
                                </hc:Card.Background>
                                <StackPanel HorizontalAlignment="Right">
                                    <Border Margin="0" Padding="0" CornerRadius="4,4,0,0" Style="{StaticResource BorderClip}">
                                        <Image Width="120" Height="100" Source="{Binding ImageSource}" Stretch="Uniform"/>
                                        <!--<Border.ContextMenu>
                                        <ContextMenu Width="120">
                                            <MenuItem Header="删除" x:Name="deleImg" Click="MenuItem_OnClick" ItemsSource="{Binding}">
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>-->
                                    </Border>
                                    <Button Margin="0,-90,0,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_OnMouseLeftButtonDown" Style="{StaticResource ButtonIconCircular.Small}" Background="Red" BorderBrush="Transparent" BorderThickness="0" Foreground="White" hc:IconElement.Geometry="{StaticResource CloseGeometry}"/>

                                </StackPanel>
                                <hc:Card.FooterTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBlockDefault}" Visibility="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White" Text="[已编辑]" HorizontalAlignment="Center"/>
                                            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBlockDefault}" Foreground="White" Text="{Binding Name}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </hc:Card.FooterTemplate>
                            </hc:Card>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <hc:Divider Grid.Row="3" Content="视频" HorizontalContentAlignment="Left" Foreground="White" Margin="0"/>

        <Grid Grid.Row="4">
            <ListBox hc:ScrollViewer.IsInertiaEnabled="True" Margin="0" BorderThickness="0"  x:Name="videoList" ItemsPanel="{StaticResource FluidMoveBehaviorWrapPanelItemsPanelTemplate}" HorizontalAlignment="Left" ItemContainerStyle="{StaticResource CustomListBoxItemStyle}" Style="{StaticResource WrapPanelHorizontalListBox}"  ItemsSource="{Binding ParentData.Result.Vedios, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="0"/>
                </ListBox.Background>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type entity1:MediaItem}">
                        <hc:Card  Margin="8" Effect="{StaticResource EffectShadow2}" MaxWidth="120" Tag="{Binding}"  Footer="{Binding Name}" MouseLeftButtonDown="UIElement_Video_OnMouseLeftButtonDown">
                            <hc:Card.Background>
                                <SolidColorBrush Color="White" Opacity="0.2"/>
                            </hc:Card.Background>

                            <StackPanel HorizontalAlignment="Right">
                                <Border CornerRadius="4,4,0,0" Style="{StaticResource BorderClip}">
                                    <Image Width="120" Height="100" Source="{Binding ImageSource}" Stretch="Uniform"/>
                                    <!--<MediaElement Width="120" Height="100" Source="{Binding Source}" Stretch="Uniform"/>-->
                                    <Border.ContextMenu>
                                        <ContextMenu Width="120">
                                            <MenuItem Header="删除" x:Name="deleImg" Click="MenuItem_OnClick" ItemsSource="{Binding}">
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                                <Button Margin="0,-90,0,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Video_Close_OnMouseLeftButtonDown" Style="{StaticResource ButtonIconCircular.Small}" Background="Red" BorderBrush="Transparent" BorderThickness="0" Foreground="White" hc:IconElement.Geometry="{StaticResource CloseGeometry}"/>

                            </StackPanel>
                            <hc:Card.FooterTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="1">
                                        <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBlockDefault}" Foreground="White" Text="{Binding }" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </hc:Card.FooterTemplate>
                        </hc:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
