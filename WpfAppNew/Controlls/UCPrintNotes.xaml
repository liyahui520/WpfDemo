<UserControl x:Class="WpfAppNew.Controlls.UCPrintNotes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfAppNew.Controlls"
             xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit" Loaded="UCPrintNotes_OnLoaded"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
            <Button Content="导出" Margin="5" Style="{StaticResource ButtonPrimary}" Click="ButtonBase_OnClick"/>
            <Button Content="打印" Margin="5" Style="{StaticResource ButtonPrimary}" Click="Print_OnClick"/>
            <!-- 图片加载进度指示器 -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="10,0" Visibility="Collapsed">
                <ProgressBar x:Name="ImageProgressBar" Width="150" Height="20" Margin="5" 
                           Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="ProgressText" Text="加载图片中..." Margin="5" 
                         VerticalAlignment="Center" Foreground="#666"/>
            </StackPanel>
        </StackPanel>
        <dxre:RichEditControl Grid.Row="1" x:Name="richEditControl1" CommandBarStyle="Empty"/>
        
        <!-- 图片加载遮罩层 -->
        <Grid x:Name="LoadingOverlay" Grid.Row="1" Background="#80FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="200" Height="25" IsIndeterminate="True" Margin="10"/>
                <TextBlock x:Name="LoadingStatusText" Text="正在加载图片，请稍候..." 
                         HorizontalAlignment="Center" FontSize="14" Foreground="#333" Margin="10"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
