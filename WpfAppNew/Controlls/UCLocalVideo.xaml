<hc:Window x:Class="WpfAppNew.Controlls.UCLocalVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Title="本地视频播放器 - 宠物医疗系统"
             Background="#FF2D2D30">

    <hc:Window.Resources>
        <!-- 转换器定义 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- 统一的主题样式资源 -->
        
        <!-- 主要按钮样式 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.2"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E90FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0066CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3F3F46"/>
                                <Setter Property="Foreground" Value="#FF666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 控制按钮样式 -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF606060"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF2A2A2A"/>
                                <Setter Property="Foreground" Value="#FF666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条样式 -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="#FF007ACC"/>
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" 
                                    Background="{TemplateBinding Background}" 
                                    Height="{TemplateBinding Height}"
                                    CornerRadius="4"/>
                            <Track Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{TemplateBinding Foreground}" 
                                                  Height="{TemplateBinding Height}"
                                                  Template="{x:Null}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" 
                                                  Template="{x:Null}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" 
                                           Background="{TemplateBinding Foreground}" 
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"
                                                         Stroke="White" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本样式 -->
        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="TimeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- 下拉框样式 -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 分组框样式 -->
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </hc:Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#FF1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题图标和文字 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="本地视频播放器" 
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 播放器选择 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="播放器:" Style="{StaticResource InfoTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PlayerSelector" 
                              Style="{StaticResource ModernComboBoxStyle}"
                              Width="150"
                              SelectionChanged="PlayerSelector_SelectionChanged">
                        <ComboBoxItem Content="WPF MediaElement" Tag="MediaElement" IsSelected="True"/>
                        <ComboBoxItem Content="WPF MediaKit" Tag="MediaKit"/>
                        <ComboBoxItem Content="自定义播放器" Tag="Custom"/>
                    </ComboBox>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" 
                            Content="设置" 
                            Style="{StaticResource ModernButtonStyle}"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 视频播放区域 -->
        <Border Grid.Row="1" Background="#FF000000" Margin="1">
            <Grid>
                <!-- 播放器容器 -->
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Border x:Name="PlayerContainer" 
                            Background="#FF000000"
                            ClipToBounds="True"
                            MinWidth="320"
                            MinHeight="240">
                        <!-- 播放器控件将在代码中动态添加 -->
                    </Border>
                </Viewbox>

                <!-- 加载指示器 -->
                <Grid x:Name="LoadingPanel" 
                      Background="#80000000" 
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <hc:LoadingCircle Width="48" Height="48" 
                                          Foreground="#FF007ACC" 
                                          IsRunning="True"/>
                        <TextBlock Text="正在加载..." 
                                   Style="{StaticResource InfoTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 错误显示 -->
                <Grid x:Name="ErrorPanel" 
                      Background="#80000000" 
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <TextBlock Text="⚠️" 
                                   FontSize="48" 
                                   Foreground="#FFFF6B6B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" 
                                   Text="播放出错" 
                                   Style="{StaticResource InfoTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                        <Button Content="重试" 
                                Style="{StaticResource ModernButtonStyle}"
                                Click="RetryButton_Click"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 无文件提示 -->
                <Grid x:Name="NoFilePanel" 
                      Background="#80000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" 
                                   FontSize="64" 
                                   Foreground="#FF6C6C6C"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="点击'打开文件'选择视频" 
                                   Style="{StaticResource InfoTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                        <TextBlock Text="支持 MP4, AVI, WMV, MOV 等格式" 
                                   Style="{StaticResource InfoTextStyle}"
                                   HorizontalAlignment="Center"
                                   Foreground="#FF6C6C6C"
                                   FontSize="10"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 文件信息显示 -->
                <Border Background="#80000000" 
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Left"
                        Margin="10"
                        CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=FileNameText, Path=Text}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=FileNameText, Path=Text}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="FileNameText" 
                               Text="" 
                               Style="{StaticResource InfoTextStyle}"
                               Margin="8,4"/>
                </Border>
            </Grid>
        </Border>

        <!-- 底部控制栏 -->
        <Border Grid.Row="2" Background="#FF2C3E50" BorderBrush="#FF34495E" BorderThickness="0,1,0,0">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 进度控制区域 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 当前时间 -->
                    <TextBlock x:Name="CurrentTimeText" 
                               Grid.Column="0"
                               Text="00:00" 
                               Style="{StaticResource TimeTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <!-- 进度滑块 -->
                    <Slider x:Name="ProgressSlider" 
                            Grid.Column="1"
                            Style="{StaticResource ModernSliderStyle}"
                            Minimum="0" 
                            Maximum="100" 
                            Value="0"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            ValueChanged="ProgressSlider_ValueChanged"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"/>

                    <!-- 总时长 -->
                    <TextBlock x:Name="TotalTimeText" 
                               Grid.Column="2"
                               Text="00:00" 
                               Style="{StaticResource TimeTextStyle}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 播放控制区域 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧控制按钮 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenFileButton" 
                                Content="📁" 
                                Style="{StaticResource ControlButtonStyle}"
                                Click="OpenFileButton_Click"
                                ToolTip="打开文件"/>
                        
                        <Button x:Name="PlayPauseButton" 
                                Content="▶️" 
                                Style="{StaticResource ControlButtonStyle}"
                                Click="PlayPauseButton_Click"
                                ToolTip="播放/暂停"/>
                        
                        <Button x:Name="StopButton" 
                                Content="⏹️" 
                                Style="{StaticResource ControlButtonStyle}"
                                Click="StopButton_Click"
                                ToolTip="停止"/>
                    </StackPanel>

                    <!-- 中间信息显示 -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="状态: " 
                                   Style="{StaticResource InfoTextStyle}"/>
                        <TextBlock x:Name="StatusText" 
                                   Text="就绪" 
                                   Style="{StaticResource InfoTextStyle}"
                                   Foreground="#FF007ACC"/>
                    </StackPanel>

                    <!-- 右侧音量控制 -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <Button x:Name="MuteButton" 
                                Content="🔊" 
                                Style="{StaticResource ControlButtonStyle}"
                                Click="MuteButton_Click"
                                ToolTip="静音/取消静音"/>
                        
                        <Slider x:Name="VolumeSlider" 
                                Style="{StaticResource ModernSliderStyle}"
                                Minimum="0" 
                                Maximum="100" 
                                Value="50"
                                Width="80"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ValueChanged="VolumeSlider_ValueChanged"
                                ToolTip="音量"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</hc:Window>