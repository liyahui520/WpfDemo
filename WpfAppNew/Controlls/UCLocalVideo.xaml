<hc:Window x:Class="WpfAppNew.Controlls.UCLocalVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#FF1E1E1E">

    <hc:Window.Resources>
        <!-- 主题样式资源 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1C1C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条样式 -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="#FF007ACC"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" 
                                    Background="{TemplateBinding Background}" 
                                    Height="{TemplateBinding Height}"
                                    CornerRadius="3"/>
                            <Border Name="PART_SelectionRange" 
                                    Background="{TemplateBinding Foreground}" 
                                    Height="{TemplateBinding Height}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                         Stroke="#FFFFFFFF" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本样式 -->
        <Style x:Key="TimeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- 播放器选择样式 -->
        <Style x:Key="PlayerSelectorStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </hc:Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 播放器选择 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="播放器:" Style="{StaticResource TimeTextStyle}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PlayerSelector" 
                              Style="{StaticResource PlayerSelectorStyle}"
                              Width="150"
                              SelectionChanged="PlayerSelector_SelectionChanged">
                        <ComboBoxItem Content="WPF MediaElement" Tag="MediaElement" IsSelected="True"/>
                        <ComboBoxItem Content="WPF MediaKit" Tag="MediaKit"/>
                        <ComboBoxItem Content="自定义播放器" Tag="Custom"/>
                    </ComboBox>
                </StackPanel>

                <!-- 文件信息 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="FileNameText" 
                               Text="未加载文件" 
                               Style="{StaticResource TimeTextStyle}"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenFileButton" 
                            Content="打开文件" 
                            Style="{StaticResource ModernButtonStyle}"
                            Click="OpenFileButton_Click"/>
                    <Button x:Name="SettingsButton" 
                            Content="设置" 
                            Style="{StaticResource ModernButtonStyle}"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 视频播放区域 -->
        <Border Grid.Row="1" Background="#FF000000" Margin="1">
            <Grid>
                <!-- 播放器容器 -->
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Border x:Name="PlayerContainer" 
                            Background="#FF000000"
                            ClipToBounds="True"
                            MinWidth="320"
                            MinHeight="240">
                        <!-- 播放器控件将在代码中动态添加 -->
                    </Border>
                </Viewbox>

                <!-- 加载指示器 -->
                <Grid x:Name="LoadingPanel" 
                      Background="#80000000" 
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <hc:LoadingCircle Width="48" Height="48" 
                                          Foreground="#FF007ACC" 
                                          IsRunning="True"/>
                        <TextBlock Text="正在加载..." 
                                   Style="{StaticResource TimeTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 错误显示 -->
                <Grid x:Name="ErrorPanel" 
                      Background="#80000000" 
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <TextBlock Text="⚠️" 
                                   FontSize="48" 
                                   Foreground="#FFFF6B6B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" 
                                   Text="播放出错" 
                                   Style="{StaticResource TimeTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                        <Button Content="重试" 
                                Style="{StaticResource ModernButtonStyle}"
                                Click="RetryButton_Click"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 无文件提示 -->
                <Grid x:Name="NoFilePanel" 
                      Background="#80000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" 
                                   FontSize="64" 
                                   Foreground="#FF6C6C6C"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="点击'打开文件'选择视频" 
                                   Style="{StaticResource TimeTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                        <TextBlock Text="支持 MP4, AVI, WMV, MOV 等格式" 
                                   Style="{StaticResource TimeTextStyle}"
                                   HorizontalAlignment="Center"
                                   Foreground="#FF6C6C6C"
                                   FontSize="10"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 底部控制栏 -->
        <Border Grid.Row="2" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 进度条 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText" 
                               Grid.Column="0"
                               Text="00:00" 
                               Style="{StaticResource TimeTextStyle}"/>

                    <Slider x:Name="PositionSlider" 
                            Grid.Column="1"
                            Style="{StaticResource ModernSliderStyle}"
                            Minimum="0" Maximum="100" Value="0"
                            ValueChanged="PositionSlider_ValueChanged"
                            PreviewMouseDown="PositionSlider_PreviewMouseDown"
                            PreviewMouseUp="PositionSlider_PreviewMouseUp"/>

                    <TextBlock x:Name="DurationText" 
                               Grid.Column="2"
                               Text="00:00" 
                               Style="{StaticResource TimeTextStyle}"/>
                </Grid>

                <!-- 控制按钮 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 播放控制 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayPauseButton" 
                                Style="{StaticResource ModernButtonStyle}"
                                Width="50"
                                Click="PlayPauseButton_Click">
                            <TextBlock Text="▶" FontSize="14" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="StopButton" 
                                Style="{StaticResource ModernButtonStyle}"
                                Width="50"
                                Click="StopButton_Click">
                            <TextBlock Text="⏹" FontSize="14" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="PreviousButton" 
                                Style="{StaticResource ModernButtonStyle}"
                                Width="50"
                                Click="PreviousButton_Click">
                            <TextBlock Text="⏮" FontSize="12" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="NextButton" 
                                Style="{StaticResource ModernButtonStyle}"
                                Width="50"
                                Click="NextButton_Click">
                            <TextBlock Text="⏭" FontSize="12" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- 播放速度 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="速度:" Style="{StaticResource TimeTextStyle}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SpeedSelector" 
                                  Style="{StaticResource PlayerSelectorStyle}"
                                  Width="80"
                                  SelectionChanged="SpeedSelector_SelectionChanged">
                            <ComboBoxItem Content="0.5x" Tag="0.5"/>
                            <ComboBoxItem Content="0.75x" Tag="0.75"/>
                            <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                            <ComboBoxItem Content="1.25x" Tag="1.25"/>
                            <ComboBoxItem Content="1.5x" Tag="1.5"/>
                            <ComboBoxItem Content="2.0x" Tag="2.0"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 音量控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" 
                                Style="{StaticResource ModernButtonStyle}"
                                Width="50"
                                Click="MuteButton_Click">
                            <TextBlock Text="🔊" FontSize="12" HorizontalAlignment="Center"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" 
                                Style="{StaticResource ModernSliderStyle}"
                                Width="80" 
                                Minimum="0" Maximum="100" Value="50"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" 
                                   Text="50%" 
                                   Style="{StaticResource TimeTextStyle}"
                                   Width="35"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</hc:Window>