<UserControl x:Class="WpfAppNew.Controlls.TestInfoDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Tools.Extend.Converters;assembly=Tools"
             xmlns:controlls="clr-namespace:WpfAppNew.Controlls"
             xmlns:entity1="clr-namespace:Entity.Entity;assembly=Entity"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#1E1E1E">
 
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <controlls:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
        <!-- 样式定义 - 与FrmHistory.xaml保持一致的深色主题 -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="MediaBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 媒体控件样式 -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部信息区域 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="300">
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="检查详情信息" Style="{StaticResource HeaderTextStyle}" 
                              HorizontalAlignment="Center" FontSize="20" Margin="0,0,0,16"/>
                    
                    <!-- 基本信息 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 第一行 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="病历号：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding RecordNo}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="检查名称：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding TestName}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="检查时间：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding TestDate, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="宠物名：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Pet}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>

                        <!-- 第二行 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="宠主：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Customer}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="联系电话：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding CustomerPhone}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="性别：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Gender}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="种类：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Type}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>

                        <!-- 第三行 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="品种：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Variety}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="年龄：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Age}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="绝育状态：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Neuter}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="检查医生：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding DCOperation}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>

                        <!-- 第四行 -->
                        <!--<StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="大小：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Size}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="数量：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding Count}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>-->

                        <!-- 第五行 - 所见 -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Vertical" Margin="0,8,0,4">
                            <TextBlock Text="镜检结果：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding See}" Style="{StaticResource ValueTextStyle}" 
                                      TextWrapping="Wrap" MaxHeight="60" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- 第六行 - 备注 -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Vertical" Margin="0,8,0,4">
                            <TextBlock Text="备注：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Text="{Binding TestInfo.Result.Remark}" Style="{StaticResource ValueTextStyle}" 
                                      TextWrapping="Wrap" MaxHeight="60" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 底部媒体区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧图片显示区域 -->
            <Border Grid.Column="0" Style="{StaticResource MediaBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="检查图片" Style="{StaticResource HeaderTextStyle}" 
                              HorizontalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <Image x:Name="MainImage" 
                                  Source="{Binding SelectedImage.ImageSource}"
                                  Stretch="Uniform"
                                  StretchDirection="Both"
                                  MinHeight="200"
                                  MaxHeight="400"/>
                            
                            <TextBlock Text="暂无图片" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      FontSize="14" 
                                      Foreground="#BDC3C7"
                                      Visibility="{Binding NoImages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- 图片缩略图列表 -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" 
                                 VerticalScrollBarVisibility="Disabled" MaxHeight="80">
                        <ItemsControl x:Name="ImageThumbnails" ItemsSource="{Binding TestInfo.Result.Images}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type entity1:ImageItem}">
                                    <Border BorderBrush="#4A90E2" BorderThickness="2" 
                                           CornerRadius="4" Margin="4" Cursor="Hand"
                                           Background="{Binding IsSelected, Converter={StaticResource BooleanToBrushConverter}}">
                                        <!--<TextBlock Text="{Binding ImageSource}"></TextBlock>-->
                                        <Image Source="{Binding ImageSource}" 
                                              Width="60" Height="60" 
                                              Stretch="UniformToFill"
                                              MouseLeftButtonUp="ThumbnailImage_Click"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧视频显示区域 -->
            <Border Grid.Column="1" Style="{StaticResource MediaBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="检查视频" Style="{StaticResource HeaderTextStyle}" 
                              HorizontalAlignment="Center"/>

                    <Grid Grid.Row="1">
                        <MediaElement x:Name="VideoPlayer" 
                                     Source="{Binding SelectedVideo.Source}"
                                     LoadedBehavior="Manual"
                                     UnloadedBehavior="Manual"
                                     Stretch="Uniform"
                                     StretchDirection="Both"
                                     MinHeight="200"
                                     MaxHeight="400"
                                     MediaOpened="VideoPlayer_MediaOpened"
                                     MediaEnded="VideoPlayer_MediaEnded"/>
                        
                        <TextBlock Text="暂无视频" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  FontSize="14" 
                                  Foreground="#BDC3C7"
                                  Visibility="{Binding NoVideos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <!-- 视频控制面板 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="PlayButton" Content="▶ 播放" Width="80" Height="32" 
                               Style="{StaticResource MediaButtonStyle}" Click="PlayButton_Click"/>
                        <Button x:Name="PauseButton" Content="⏸ 暂停" Width="80" Height="32" 
                               Style="{StaticResource MediaButtonStyle}" Click="PauseButton_Click"/>
                        <Button x:Name="StopButton" Content="⏹ 停止" Width="80" Height="32" 
                               Style="{StaticResource MediaButtonStyle}" Click="StopButton_Click"/>
                    </StackPanel>

                    <!-- 视频缩略图列表 -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" 
                                 VerticalScrollBarVisibility="Disabled" MaxHeight="80" Margin="0,40,0,0">
                        <ItemsControl x:Name="VideoThumbnails" ItemsSource="{Binding TestInfo.Result.Vedios}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type entity1:MediaItem}">
                                    <Border BorderBrush="#4A90E2" BorderThickness="2" 
                                           CornerRadius="4" Margin="4" Cursor="Hand"
                                           Background="{Binding IsSelected, Converter={StaticResource BooleanToBrushConverter}}">
                                        <Grid>
                                            <Image Source="{Binding ImageSource}" 
                                                  Width="80" Height="60" 
                                                  Stretch="UniformToFill"
                                                  MouseLeftButtonUp="ThumbnailVideo_Click"/>
                                            <Polygon Fill="White" Opacity="0.8" 
                                                    Points="25,20 25,40 40,30" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>