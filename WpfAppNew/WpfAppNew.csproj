  <!-- PostBuild事件：复制Libs文件夹到输出目录 -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <LibsFiles Include="$(ProjectDir)..\Libs\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibsFiles)" DestinationFiles="@(LibsFiles->'$(OutputPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="已复制Libs文件夹到输出目录: $(OutputPath)\" Importance="high" />
  </Target>

